# {{ ansible_managed }}
[Unit]
Description=ALICE fault injection — inject, observe, restore, score
After=network-online.target opensearch.service
Wants=network-online.target

[Service]
Type=simple
MemoryAccounting=yes
MemoryHigh={{ alice_service_memory_high }}
MemoryMax={{ alice_service_memory_max }}
User=root
Group=root
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=METRICS_INDEX={{ cockpit_metrics_index }}
Environment=SIGNALS_INDEX={{ signals_index }}
Environment=INCIDENTS_INDEX={{ incidents_index }}
Environment=NOTIFICATIONS_INDEX={{ notifications_index }}
Environment=GRADE_FLOOR={{ anomaly_grade_floor }}
Environment=INJECT_REQUEST_PATH={{ alice_ops_inject_request }}
Environment=INJECT_STATUS_PATH={{ alice_ops_inject_status }}
Environment=INJECT_REPORT_DIR={{ alice_ops_inject_report_dir }}
Environment=INJECT_SCORE_SCRIPT={{ alice_ops_score_injection_script }}
Environment=CAUSAL_EDGES={{ alice_bootstrap_causal_edges }}
Environment=INJECT_WORKER_AGENTS={{ worker_fault_agent_endpoints | join(',') }}
Environment=INJECT_WORKER_REPLAY={{ worker_replay_endpoints | join(',') }}
Environment=INJECT_PROJECTOR_AGENT=http://{{ signal_projector_address }}:{{ fault_agent_port }}
Environment=INJECT_PROJECTOR_SERVICE={{ signal_projector_service_name }}
Environment=INJECT_METRICS_SERVICE={{ cockpit_metrics_service_name }}
Environment=INJECT_FLUENT_BIT_SERVICE=fluent-bit
Environment=INJECT_FAULT_TOKEN={{ fault_agent_token }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ alice_ops_inject_script }}
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=600s
Nice=10

[Install]
WantedBy=multi-user.target
