# {{ ansible_managed }}
[Unit]
Description=ALICE template catalog — canonical templates from every route this node writes
After=network-online.target opensearch.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=ALICE_NODE_ID={{ node_id }}
Environment=CATALOG_INDEX={{ template_catalog_index }}
Environment=CATALOG_MAX_LINES={{ template_catalog_max_lines }}
Environment=CATALOG_PAGE={{ template_catalog_page }}
Environment=ALICE_TEMPLATING_PATH={{ template_catalog_templating_dir }}
Environment=CATALOG_STATE_DIR={{ template_catalog_state_dir }}
Environment=CATALOG_CENTRAL_INDEX={{ template_catalog_central_index }}
Environment=CATALOG_INFOLOGGER_INDEX={{ template_catalog_infologger_index }}
Environment=CATALOG_MAX_TEMPLATES={{ template_catalog_max_templates }}
ExecStart={{ template_catalog_venv }}/bin/python {{ template_catalog_script }}
# The drain tree survives between runs, so it is state and not a cache: rebuilt
# from empty every ten minutes it mines the same messages into different
# templates depending on which batch they fell in.
StateDirectory=alice-template-catalog
# The mining tree is the memory here. Depth and max_children bound the SHAPE of
# the tree and not its size -- neither of them caps how many clusters it holds --
# so the bound is CATALOG_MAX_TEMPLATES above, and this limit is set from
# measurement against it: 20,000 clusters hold 61 MB, and serialising them, which
# jsonpickle does by building the whole string in memory, peaks at 208 MB. 50,000
# clusters would peak at 437 MB and leave nothing for the rest of the process.
# The whole 55,963,050-line archive pass mined 4,221 templates.
MemoryMax=512M
Nice=10
IOSchedulingClass=idle
