# {{ ansible_managed }}
[Unit]
Description=Run the ALICE template catalog every {{ template_catalog_interval }}

[Timer]
OnBootSec={{ template_catalog_interval }}
OnUnitActiveSec={{ template_catalog_interval }}
# The three workers would otherwise all mine on the same tick and all bulk into
# the storage tier at the same instant.
RandomizedDelaySec=120
Persistent=true

[Install]
WantedBy=timers.target
