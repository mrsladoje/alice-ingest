# {{ ansible_managed }}

map $http_upgrade $dashboards_connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen {{ dashboards_external_port }} ssl;
    listen [::]:{{ dashboards_external_port }} ssl;
    server_name _;

    ssl_certificate     {{ dashboards_nginx_tls_cert }};
    ssl_certificate_key {{ dashboards_nginx_tls_key }};
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    auth_basic           "ALICE Logging Dashboards";
    auth_basic_user_file {{ dashboards_nginx_htpasswd_file }};

    location = /ops {
        return 301 /ops/;
    }

    location /ops/ {
        proxy_pass http://127.0.0.1:{{ ops_internal_port }}/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

{% if shifter_enabled | bool %}
    location = /live {
        return 301 /live/;
    }

    # Server-Sent Events: buffering must be off or nginx holds records back
    # until its buffer fills. The long read timeout keeps an idle stream open;
    # the server sends its own keepalive well inside it.
    location /live/ {
        proxy_pass http://{{ shifter_host }}:{{ shifter_port }}/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        chunked_transfer_encoding off;
        proxy_set_header Connection        "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
{% endif %}

    location = /alertmanager {
        return 301 /alertmanager/;
    }

    location /alertmanager/ {
        proxy_pass http://127.0.0.1:{{ alertmanager_port }}/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ dashboards_internal_port }};
        proxy_http_version 1.1;

        # Dashboards needs the websocket upgrade headers (live queries / UI
        # push channel) — without these the proxy silently downgrades every
        # connection to plain HTTP and parts of the UI stop updating.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $dashboards_connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_read_timeout 90s;
    }
}
