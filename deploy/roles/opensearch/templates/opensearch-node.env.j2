# {{ ansible_managed }}
#
# The info-tier index settings, published to the node so register_node.sh writes
# the same index template the control host writes. These are OpenSearch index
# settings, so they are owned here and not by whichever service happens to load
# them. On a worker, fluent-bit.service loads this file beside node.env.

ALICE_INFO_SEARCH_IDLE_AFTER={{ opensearch_info_search_idle_after }}
ALICE_INFO_TRANSLOG_SYNC_INTERVAL={{ opensearch_info_translog_sync_interval }}
ALICE_INFO_MERGE_THREADS={{ opensearch_info_merge_threads }}

# A literal, not a variable. ism.sh.j2 creates this policy under this exact name
# and verify_detection.py asserts it. See the note in defaults/main.yml.
ALICE_INFO_RETENTION_POLICY=alice-generic-info-retention
