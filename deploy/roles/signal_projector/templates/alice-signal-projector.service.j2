# {{ ansible_managed }}
[Unit]
Description=ALICE signal projector — domain semantics for alerts and anomalies
After=network-online.target opensearch.service
Wants=network-online.target

[Service]
Type=simple
MemoryAccounting=yes
MemoryHigh={{ signal_projector_memory_high }}
MemoryMax={{ signal_projector_memory_max }}
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=ALERTMANAGER_URL=http://{{ alertmanager_host_address }}:{{ alertmanager_port }}
Environment=SIGNALS_INDEX={{ signals_index }}
Environment=INCIDENTS_INDEX={{ incidents_index }}
Environment=NOTIFICATIONS_INDEX={{ notifications_index }}
Environment=METRICS_INDEX={{ cockpit_metrics_index }}
Environment=ROSTER_INDEX={{ fleet_roster_index }}
Environment=STATE_INDEX={{ lane_state_index }}
Environment=SIGNAL_CATALOG={{ alice_bootstrap_signal_catalog }}
Environment=CAUSAL_EDGES={{ alice_bootstrap_causal_edges }}
Environment=CLUSTER_ID={{ cluster_id }}
Environment=INTERVAL={{ signal_projector_interval_seconds }}
Environment=RESOLVE_TIMEOUT_SECONDS={{ signal_projector_resolve_timeout_seconds }}
Environment=OS_UNREACHABLE_CYCLES={{ signal_projector_os_unreachable_cycles }}
Environment=GRADE_FLOOR={{ anomaly_grade_floor }}
Environment=OVERLAP_MINUTES={{ signal_projector_overlap_minutes }}
Environment=INITIAL_LOOKBACK_MINUTES={{ signal_projector_initial_lookback_minutes }}
Environment=PAGE={{ signal_projector_page }}
Environment=BULK_DOCUMENTS={{ signal_projector_bulk_documents }}
Environment=PIT_KEEP_ALIVE={{ signal_projector_pit_keep_alive }}
Environment=RETENTION_DAYS={{ signal_projector_retention_days }}
Environment=MASS_SILENCE_FRACTION={{ signal_projector_mass_silence_fraction }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ signal_projector_script }}
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
