INGEST_PIPELINE=$(cat <<'JSON'
{
  "description": "Stamp ingest_time; ingest_lag_ms = ingest_time - collector_time; enter_system_lag_ms = collector_time - @timestamp; severity_norm and origin_host, moved off the collector by Item 5.4.",
  "processors": [
    { "set": { "field": "ingest_time", "value": "{% raw %}{{{_ingest.timestamp}}}{% endraw %}" } },
    {
      "script": {
        "lang": "painless",
        "ignore_failure": true,
        "description": "severity_norm, origin_host and program. Ported from the collector's normalize_fields Lua filter, which Item 5.4 deleted so the collector runs no per-record Lua at all. The map carries every severity spelling the five sources produce: DPL words, DataDistribution and InfoLogger single letters, DDS three-letter codes, ROOT words, and the journal's numeric priorities. STATE gets its own normalised name rather than being flattened into info, because a FairMQ transition is what an operator asks for first when a run will not start. ALARM normalises to error, because a front-end alarm IS a fault and every consumer that already filters on error should see it without being changed. program is filled in from facility for InfoLogger and from COMM for a kernel record, so one field names the process on every source. A line no collector parser claimed arrives with its text in `log`; that becomes `message` here, because the mapping is not dynamic and a field nobody mapped is stored but never searchable.",
        "source": "{% raw %}Map m = ['I':'info','W':'warning','E':'error','F':'fatal','D':'debug','T':'trace','Info':'info','Warning':'warning','Error':'error','Fatal':'fatal','Sys':'system','Break':'error','inf':'info','wrn':'warning','err':'error','fat':'fatal','dbg':'debug','cout':'info','INFO':'info','WARN':'warning','ERROR':'error','FATAL':'fatal','DEBUG':'debug','TRACE':'trace','STATE':'state','ALARM':'error','0':'fatal','1':'fatal','2':'fatal','3':'error','4':'warning','5':'info','6':'info','7':'debug']; def s = ctx.severity; def n = s == null ? null : m.get(s.toString()); ctx.severity_norm = n == null ? 'unknown' : n; def h = ctx.hostname == null ? ctx.host : ctx.hostname; if (h != null) { ctx.origin_host = h; } if (ctx.program == null && ctx.facility != null) { ctx.program = ctx.facility; } if (ctx.program == null && ctx.COMM != null) { ctx.program = ctx.COMM; } if (ctx.message == null && ctx.log != null) { ctx.message = ctx.log; ctx.remove('log'); }{% endraw %}"
      }
    },
    {
      "script": {
        "lang": "painless",
        "ignore_failure": true,
        "source": "{% raw %}long toEpochMillis(def v) { if (v == null) { return -1L; } if (v instanceof Number) { long n = ((Number)v).longValue(); return n < 100000000000L ? n * 1000L : n; } String s = v.toString().trim(); if (s.length() == 0) { return -1L; } if (Character.isDigit(s.charAt(0)) && s.indexOf('-') < 0 && s.indexOf('T') < 0 && s.indexOf(' ') < 0) { int dot = s.indexOf('.'); String whole = dot < 0 ? s : s.substring(0, dot); long n = Long.parseLong(whole); return n < 100000000000L ? n * 1000L : n; } if (s.indexOf(' ') >= 0 && s.indexOf('T') < 0) { s = s.replace(' ', 'T'); } if (s.length() >= 19 && s.indexOf('Z') < 0 && s.indexOf('+') < 0 && s.lastIndexOf('-') <= 7) { s = s + 'Z'; } try { return Instant.parse(s).toEpochMilli(); } catch (Exception e1) { try { return Instant.parse(s + 'Z').toEpochMilli(); } catch (Exception e2) { return -1L; } } } if (ctx.collector_time == null) { return; } long collectorMs = toEpochMillis(ctx.collector_time); if (collectorMs < 0) { return; } if (ctx.ingest_time != null) { long ingestMs = toEpochMillis(ctx.ingest_time); if (ingestMs >= 0) { ctx.ingest_lag_ms = ingestMs - collectorMs; } } if (ctx['@timestamp'] != null) { long eventMs = toEpochMillis(ctx['@timestamp']); if (eventMs >= 0) { ctx.enter_system_lag_ms = collectorMs - eventMs; } }{% endraw %}"
      }
    }
  ]
}
JSON
)

