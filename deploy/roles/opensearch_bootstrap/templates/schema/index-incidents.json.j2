{
  "index_patterns": ["{{ incidents_index }}"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 2,
      "codec": "zstd",
      "refresh_interval": "5s",
      "index.routing.allocation.require.role": "storage"
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp":         { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "incident_id":        { "type": "keyword" },
        "class":              { "type": "keyword" },
        "alertname":          { "type": "keyword" },
        "title":              { "type": "keyword" },
        "diagnosis":          { "type": "text" },
        "operator_action":    { "type": "text" },
        "affected":           { "type": "keyword" },
        "candidate_causes":   { "type": "keyword" },
        "candidate_cause_ids": { "type": "keyword" },
        "cause_belief":       { "type": "float" },
        "cause_measured":     { "type": "boolean" },
        "cause_precedes":     { "type": "boolean" },
        "source_label":       { "type": "keyword" },
        "state":              { "type": "keyword" },
        "severity":           { "type": "keyword" },
        "cluster_id":         { "type": "keyword" },
        "entity_kind":        { "type": "keyword" },
        "collector_id":       { "type": "keyword" },
        "family":             { "type": "keyword" },
        "notification_scope": { "type": "keyword" },
        "topology_version":   { "type": "keyword" },
        "source_kind":        { "type": "keyword" },
        "entity_id":          { "type": "keyword" },
        "feed":               { "type": "keyword" },
        "episode_state":      { "type": "keyword" },
        "episode_id":         { "type": "keyword" },
        "group_id":           { "type": "keyword" },
        "episode_start":      { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "healthy_windows":    { "type": "integer" },
        "last_evaluation":    { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "last_breach_window": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "last_healthy_window": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "stale_since":        { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "member_count_truncated": { "type": "boolean" },
        "supersedes_version": { "type": "keyword" },
        "opened_at":          { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "resolved_at":        { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "last_seen":          { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "member_count":       { "type": "integer" },
        "suppressed_count":   { "type": "integer" },
        "latest_grade":       { "type": "double" },
        "worst_grade":        { "type": "double" },
        "latest_confidence":  { "type": "double" },
        "entity_samples":     { "type": "keyword" },
        "signal_ids":         { "type": "keyword" }
      }
    }
  },
  "_meta": { "family": "incidents", "written_by": "alice-signal-projector", "note": "one stateful episode; Alertmanager is the delivery layer, this is the record" }
}
