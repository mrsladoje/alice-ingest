{#
  Bulk fan-out spreads across primaries instead of funnelling through the one
  node that holds a single primary. Pinned low here by shard budget, not by
  design — see log_primary_shards_storage in group_vars/all.yml.
#}
{
  "index_patterns": ["application-logs-central-*"],
  "composed_of": ["alice-logs-application-mappings"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": {{ log_primary_shards_storage }},
      "number_of_replicas": 2,
      "codec": "zstd",
      "index.default_pipeline": "alice-add-ingest-time",
      "index.routing.allocation.require.role": "storage",
      "index.plugins.index_state_management.rollover_alias": "application-logs-central"
    }
  },
  "_meta": { "note": "storage tier: durable, replicated, pinned to require.role=storage" }
}
