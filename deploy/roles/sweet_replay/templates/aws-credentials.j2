# Managed by Ansible (sweet_replay) — local edits will be overwritten.
# S3 credentials for the replay engine's boto3 client. Values come only from
# ansible-vault and the file is regenerated on every run.
[{{ s3_aws_profile }}]
aws_access_key_id = {{ s3_access_key_id }}
aws_secret_access_key = {{ s3_secret_access_key }}
