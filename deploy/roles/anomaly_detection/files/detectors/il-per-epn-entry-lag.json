{
  "name": "il-per-epn-entry-lag",
  "description": "InfoLogger per-EPN p95(enter_system_lag_ms) (archive-age under preserved replay)",
  "time_field": "collector_time",
  "indices": [
    "infologger"
  ],
  "category_field": [
    "origin_host"
  ],
  "feature_attributes": [
    {
      "feature_name": "p95_entry_lag",
      "feature_enabled": true,
      "aggregation_query": {
        "p95_entry_lag": {
          "percentiles": {
            "field": "enter_system_lag_ms",
            "percents": [
              95
            ]
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 1,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 2,
      "unit": "Minutes"
    }
  },
  "shingle_size": 8
}
