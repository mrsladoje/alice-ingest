{
  "name": "info-volume-slow",
  "description": "generic-log-info per-EPN volume 30m",
  "time_field": "collector_time",
  "indices": [
    "generic-log-info-*"
  ],
  "feature_attributes": [
    {
      "feature_name": "volume",
      "feature_enabled": true,
      "aggregation_query": {
        "volume": {
          "value_count": {
            "field": "@timestamp"
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 30,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 2,
      "unit": "Minutes"
    }
  },
  "shingle_size": 8,
  "category_field": [
    "origin_host"
  ],
  "imputation_option": {
    "method": "ZERO"
  }
}
