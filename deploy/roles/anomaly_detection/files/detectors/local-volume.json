{
  "name": "local-volume",
  "description": "application-logs-local per-EPN volume",
  "time_field": "collector_time",
  "indices": [
    "application-logs-local-*"
  ],
  "feature_attributes": [
    {
      "feature_name": "volume",
      "feature_enabled": true,
      "aggregation_query": {
        "volume": {
          "value_count": {
            "field": "@timestamp"
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 1,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 2,
      "unit": "Minutes"
    }
  },
  "shingle_size": 8,
  "category_field": [
    "origin_host"
  ],
  "imputation_option": {
    "method": "ZERO"
  }
}
