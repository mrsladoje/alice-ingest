# {{ ansible_managed }}
global:
  resolve_timeout: {{ alertmanager_resolve_timeout }}

route:
  receiver: alice-notification-ingest
  group_by: ['cluster_id', 'alertname']
  group_wait: {{ alertmanager_group_wait }}
  group_interval: {{ alertmanager_group_interval }}
  repeat_interval: {{ alertmanager_repeat_interval }}
  routes:
    - matchers:
        - notification_scope =~ "collector:.+"
      group_by: ['cluster_id', 'alertname', 'notification_scope']
      routes:
        - matchers:
            - severity = "page"
          group_wait: {{ alertmanager_page_group_wait }}
          group_interval: {{ alertmanager_page_group_interval }}
    - matchers:
        - severity = "page"
      group_wait: {{ alertmanager_page_group_wait }}
      group_interval: {{ alertmanager_page_group_interval }}

{# Generated from causal_edges.json, the one place an edge is declared. Only
   proven edges reach this file; the rest rank as candidate causes instead. #}
{% set _edges = (lookup('file', causal_edges_file) | from_json)['edges'] %}
{% set _rules = {} %}
{% for e in _edges if e.proven %}
{%   set _key = e.cause ~ '|' ~ (e.cause_severity | default('')) ~ '|' ~ (e.equal | join(',')) %}
{%   if _key not in _rules %}
{%     set _ = _rules.update({_key: {'cause': e.cause, 'severity': e.cause_severity | default(none), 'equal': e.equal, 'symptoms': []}}) %}
{%   endif %}
{%   set _ = _rules[_key]['symptoms'].append(e.symptom) %}
{% endfor %}
inhibit_rules:
{% for r in _rules.values() %}
  - source_matchers:
      - alertname = "{{ r.cause }}"
{% if r.severity %}
      - severity = "{{ r.severity }}"
{% endif %}
    target_matchers:
      - alertname =~ "{{ r.symptoms | unique | join('|') }}"
    equal: {{ r.equal | to_json }}
{% endfor %}

receivers:
  - name: alice-notification-ingest
    webhook_configs:
      - url: http://127.0.0.1:{{ notification_ingest_port }}/notifications
        send_resolved: true
        max_alerts: 0
{% if notification_ingest_token | length > 0 %}
        http_config:
          authorization:
            type: Bearer
            credentials: {{ notification_ingest_token }}
{% endif %}
