# {{ ansible_managed }}
[Unit]
Description=Alertmanager — notification semantics for the ALICE signal projector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ alertmanager_system_user }}
Group={{ alertmanager_system_user }}
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
ExecStart={{ alertmanager_binary }} \
  --config.file={{ alertmanager_config_file }} \
  --storage.path={{ alertmanager_data_dir }} \
  --web.listen-address=0.0.0.0:{{ alertmanager_port }} \
  --web.external-url=https://{{ ansible_host }}:{{ dashboards_external_port }}/alertmanager/ \
  --web.route-prefix=/ \
  --cluster.listen-address=
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
