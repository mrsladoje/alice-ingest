# {{ ansible_managed }}
#
# Rule R3 — this machine's identity, written once at install time so it can
# register itself at boot without the inventory. README section 9.

ALICE_NODE_ID={{ node_id }}
ALICE_LOG_ROOT={{ log_root }}
ALICE_FB_STORAGE_PATH={{ fluent_bit_storage_path }}
ALICE_FB_HTTP_LISTEN={{ fluent_bit_http_listen }}
ALICE_FB_HTTP_PORT={{ fluent_bit_http_port }}
ALICE_INFOLOGGER_TCP_PORT={{ infologger_tcp_port }}
ALICE_OS_HTTP_PORT={{ opensearch_http_port }}

# Read by register_node.sh, so the node writes the same info-tier index
# template the control host writes.
ALICE_INFO_SEARCH_IDLE_AFTER={{ opensearch_info_search_idle_after }}
ALICE_INFO_TRANSLOG_SYNC_INTERVAL={{ opensearch_info_translog_sync_interval }}
ALICE_INFO_MERGE_THREADS={{ opensearch_info_merge_threads }}
ALICE_INFO_RETENTION_POLICY=alice-generic-info-retention
