service:
  flush: {{ fluent_bit_flush_seconds }}
  log_level: info
  parsers_file: {{ collector_config_dir }}/parsers.yaml
  storage.path: ${ALICE_FB_STORAGE_PATH}/
  storage.max_chunks_up: 64
  http_server: on
  http_listen: ${ALICE_FB_HTTP_LISTEN}
  http_port: ${ALICE_FB_HTTP_PORT}
  health_check: on
  hc_errors_count: 1
  hc_retry_failure_count: 1
  hc_period: 60

multiline_parsers:
  - name: dds_multiline
    type: regex
    flush_timeout: 1000
    rules:
      - state: start_state
        regex: '/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+\s/'
        next_state: cont
      - state: cont
        regex: '/^(?!\d{4}-\d{2}-\d{2})/'
        next_state: cont
  - name: stdout_multiline
    type: regex
    flush_timeout: 1000
    rules:
      - state: start_state
        regex: '/^\S/'
        next_state: cont
      - state: cont
        regex: '/^\s/'
        next_state: cont

pipeline:
  inputs:
    - name: tail
      path: ${ALICE_LOG_ROOT}/dds.log,${ALICE_LOG_ROOT}/dds/*.log
      path_key: file
      tag: dds
      multiline.parser: dds_multiline
      read_from_head: true
      refresh_interval: 5
      storage.type: filesystem
      db: ${ALICE_FB_STORAGE_PATH}/dds.db

    - name: tail
      path: ${ALICE_LOG_ROOT}/stdout.log,${ALICE_LOG_ROOT}/stdout/*.log
      path_key: file
      tag: stdout
      multiline.parser: stdout_multiline
      read_from_head: true
      refresh_interval: 5
      storage.type: filesystem
      db: ${ALICE_FB_STORAGE_PATH}/stdout.db

    - name: tcp
      listen: 0.0.0.0
      port: ${ALICE_INFOLOGGER_TCP_PORT}
      tag: infologger
      format: json
      storage.type: filesystem

    - name: exec
      tag: health
      command: COLLECTOR_ID=${ALICE_NODE_ID} FB_HTTP_PORT=${ALICE_FB_HTTP_PORT} FB_EMIT_LEGACY_NODE={{ health_metrics_emit_legacy_node | bool | ternary('true', 'false') }} /usr/bin/python3 {{ collector_health_script }}
      interval_sec: {{ collector_health_interval_seconds }}
      parser: fb_health_json
      buf_size: 32k

  filters:
    - name: lua
      match: health
      call: health_deltas
      code: |
        local prev = {}
        local COUNTERS = {
          'input_records', 'output_records', 'output_errors',
          'output_retries', 'output_retries_failed', 'output_dropped'
        }
        function health_deltas(tag, ts, record)
          for i = 1, #COUNTERS do
            local key = COUNTERS[i]
            local value = record[key]
            if value ~= nil then
              local previous = prev[key]
              local delta = 0
              if previous ~= nil and value > previous then
                delta = value - previous
              end
              record[key .. '_delta'] = delta
              prev[key] = value
            end
          end
          return 1, ts, record
        end
    # The family tags are gone from this match: a re-injected record already
    # carries collector_time, so the second pass only ever ran the guard.
    - name: lua
      match_regex: ^(dds|stdout|infologger)$
      call: stamp_collector_time
      time_as_table: true
      type_int_key: collector_time
      code: |
        function stamp_collector_time(tag, ts, record)
          if record['collector_time'] ~= nil then
            return 0, ts, record
          end
          if type(ts) == 'table' then
            record['collector_time'] = ts['sec'] * 1000 + math.floor(ts['nsec'] / 1000000)
          else
            record['collector_time'] = math.floor(ts * 1000)
          end
          return 2, ts, record
        end
    # Replaces both set_host Lua filters and keeps the filename as source_file.
    # Safe before the body parsers: this reads `file`, they read `log`.
    - name: parser
      match_regex: ^(dds|stdout)$
      key_name: file
      parser: source_path
      reserve_data: on
    - name: lua
      match: infologger
      call: set_event_time
      code: |
        local last_ts = nil
        function set_event_time(tag, ts, record)
          local t = record['timestamp']
          if t ~= nil and t > 0 then
            last_ts = t
          else
            t = last_ts
          end
          if t ~= nil then
            record['_evt'] = string.format('%.3f', t)
          end
          return 1, ts, record
        end
    - name: parser
      match: infologger
      key_name: _evt
      parser: il_event_time
      reserve_data: on
    - name: record_modifier
      match: infologger
      record:
        - log_source infologger
        - node ${ALICE_NODE_ID}
      remove_key:
        - timestamp
    - name: parser
      match: dds
      key_name: log
      parser: dds_text
      reserve_data: on
    # remove_key file is a backstop: source_path consumes it when it matches.
    - name: record_modifier
      match: dds
      record:
        - log_source dds
        - node ${ALICE_NODE_ID}
      remove_key:
        - file
    - name: rewrite_tag
      match: dds
      rule: $severity ^inf$  family.local false
      rule: $severity ^.*$  family.central false
      emitter_name: dds_router
    - name: parser
      match: stdout
      key_name: log
      parser: stdout_o2
      reserve_data: on
    - name: parser
      match: stdout
      key_name: log
      parser: stdout_root
      reserve_data: on
    - name: record_modifier
      match: stdout
      record:
        - log_source stdout
        - node ${ALICE_NODE_ID}
      remove_key:
        - file
    - name: rewrite_tag
      match: stdout
      rule: $severity ^(Info|INFO)$  family.local false
      rule: $message ^.*$  family.central false
      emitter_name: stdout_router

  # normalize_fields moved into the alice-add-ingest-time ingest pipeline, so
  # there is no per-record Lua left here. Anything bypassing OpenSearch — the
  # live lane — must do that enrichment itself.

  outputs:
    - name: opensearch
      match: infologger
      host: localhost
      port: ${ALICE_OS_HTTP_PORT}
      index: infologger
      suppress_type_name: true
      trace_error: true
      buffer_size: 'False'
      storage.total_limit_size: {{ fluent_bit_log_buffer_limit }}
      retry_limit: {{ fluent_bit_log_retry_limit }}

    - name: opensearch
      match: family.local
      host: localhost
      port: ${ALICE_OS_HTTP_PORT}
      index: application-logs-local-${ALICE_NODE_ID}
      suppress_type_name: true
      trace_error: true
      buffer_size: 'False'
      storage.total_limit_size: {{ fluent_bit_log_buffer_limit }}
      retry_limit: {{ fluent_bit_log_retry_limit }}

    - name: opensearch
      match: family.central
      host: localhost
      port: ${ALICE_OS_HTTP_PORT}
      index: application-logs-central
      suppress_type_name: true
      trace_error: true
      buffer_size: 'False'
      storage.total_limit_size: {{ fluent_bit_log_buffer_limit }}
      retry_limit: {{ fluent_bit_log_retry_limit }}

    - name: opensearch
      match: health
      host: localhost
      port: ${ALICE_OS_HTTP_PORT}
      index: {{ cockpit_metrics_index }}
      suppress_type_name: true
      trace_error: true
      storage.total_limit_size: 512K
      retry_limit: 5
      workers: 0

{% if shifter_enabled | bool %}
    # The live lane: the second consumer of the stream, and the reason no queue
    # is needed yet. Never the info tier. Best-effort by construction — a small
    # buffer and one retry, so a dead viewer never pushes back on OpenSearch.
    - name: http
      match_regex: ^(infologger|family\.central)$
      host: {{ shifter_host }}
      port: {{ shifter_port }}
      uri: {{ shifter_ingest_path }}
      format: json
      json_date_key: '@timestamp'
      json_date_format: iso8601
      compress: gzip
      header: Content-Type application/json
      storage.total_limit_size: 1M
      retry_limit: 1
      net.keepalive: on
{% endif %}
