service:
  flush: 1
  log_level: info
  parsers_file: {{ collector_config_dir }}/parsers.yaml
  storage.path: {{ fluent_bit_storage_path }}/
  storage.max_chunks_up: 64
  http_server: on
  http_listen: {{ fluent_bit_http_listen }}
  http_port: {{ fluent_bit_http_port }}
  health_check: on
  hc_errors_count: 1
  hc_retry_failure_count: 1
  hc_period: 60

multiline_parsers:
  - name: dds_multiline
    type: regex
    flush_timeout: 1000
    rules:
      - state: start_state
        regex: '/^\d{4}-\d{2}-\d{2} \d{2}:\d{2}:\d{2}\.\d+\s/'
        next_state: cont
      - state: cont
        regex: '/^(?!\d{4}-\d{2}-\d{2})/'
        next_state: cont
  - name: stdout_multiline
    type: regex
    flush_timeout: 1000
    rules:
      - state: start_state
        regex: '/^\S/'
        next_state: cont
      - state: cont
        regex: '/^\s/'
        next_state: cont

pipeline:
  inputs:
    - name: tail
      path: {{ log_root }}/dds.log,{{ log_root }}/dds/*.log
      path_key: file
      tag: dds
      multiline.parser: dds_multiline
      read_from_head: true
      refresh_interval: 5
      storage.type: filesystem
      db: {{ fluent_bit_storage_path }}/dds.db

    - name: tail
      path: {{ log_root }}/stdout.log,{{ log_root }}/stdout/*.log
      path_key: file
      tag: stdout
      multiline.parser: stdout_multiline
      read_from_head: true
      refresh_interval: 5
      storage.type: filesystem
      db: {{ fluent_bit_storage_path }}/stdout.db

    - name: tcp
      listen: 0.0.0.0
      port: {{ infologger_tcp_port }}
      tag: infologger
      format: json
      storage.type: filesystem

    - name: exec
      tag: health
      command: COLLECTOR_ID={{ node_id }} FB_HTTP_PORT={{ fluent_bit_http_port }} FB_EMIT_LEGACY_NODE={{ health_metrics_emit_legacy_node | bool | ternary('true', 'false') }} /usr/bin/python3 {{ collector_health_script }}
      interval_sec: {{ collector_health_interval_seconds }}
      parser: fb_health_json
      buf_size: 32k

  filters:
    - name: lua
      match: health
      call: health_deltas
      code: |
        local prev = {}
        local COUNTERS = {
          'input_records', 'output_records', 'output_errors',
          'output_retries', 'output_retries_failed', 'output_dropped'
        }
        function health_deltas(tag, ts, record)
          for i = 1, #COUNTERS do
            local key = COUNTERS[i]
            local value = record[key]
            if value ~= nil then
              local previous = prev[key]
              local delta = 0
              if previous ~= nil and value > previous then
                delta = value - previous
              end
              record[key .. '_delta'] = delta
              prev[key] = value
            end
          end
          return 1, ts, record
        end
    - name: lua
      match_regex: ^(dds|stdout|infologger|family\.(info|other))$
      call: stamp_collector_time
      time_as_table: true
      type_int_key: collector_time
      code: |
        function stamp_collector_time(tag, ts, record)
          if record['collector_time'] ~= nil then
            return 0, ts, record
          end
          if type(ts) == 'table' then
            record['collector_time'] = ts['sec'] * 1000 + math.floor(ts['nsec'] / 1000000)
          else
            record['collector_time'] = math.floor(ts * 1000)
          end
          return 2, ts, record
        end
    - name: lua
      match: infologger
      call: set_event_time
      code: |
        local last_ts = nil
        function set_event_time(tag, ts, record)
          local t = record['timestamp']
          if t ~= nil and t > 0 then
            last_ts = t
          else
            t = last_ts
          end
          if t ~= nil then
            record['_evt'] = string.format('%.3f', t)
          end
          return 1, ts, record
        end
    - name: parser
      match: infologger
      key_name: _evt
      parser: il_event_time
      reserve_data: on
    - name: record_modifier
      match: infologger
      record:
        - log_source infologger
        - node {{ node_id }}
      remove_key:
        - timestamp
    - name: parser
      match: dds
      key_name: log
      parser: dds_text
      reserve_data: on
    - name: lua
      match: dds
      call: set_host
      code: |
        function set_host(tag, ts, record)
          local f = record['file']
          if f ~= nil then
            local h = string.match(f, 'dds/(epn%d+)%.log$')
            if h ~= nil then record['host'] = h end
          end
          return 1, ts, record
        end
    - name: record_modifier
      match: dds
      record:
        - log_source dds
        - node {{ node_id }}
      remove_key:
        - file
    - name: rewrite_tag
      match: dds
      rule: $severity ^inf$  family.info false
      rule: $severity ^.*$  family.other false
      emitter_name: dds_router
    - name: parser
      match: stdout
      key_name: log
      parser: stdout_root
      reserve_data: on
    - name: lua
      match: stdout
      call: set_host
      code: |
        function set_host(tag, ts, record)
          local f = record['file']
          if f ~= nil then
            local h = string.match(f, 'stdout/(epn%d+)%.log$')
            if h ~= nil then record['host'] = h end
          end
          return 1, ts, record
        end
    - name: record_modifier
      match: stdout
      record:
        - log_source stdout
        - node {{ node_id }}
      remove_key:
        - file
    - name: rewrite_tag
      match: stdout
      rule: $severity ^Info$  family.info false
      rule: $message ^.*$  family.other false
      emitter_name: stdout_router
    - name: lua
      match_regex: ^(dds|stdout|infologger|family\.(info|other))$
      call: normalize_fields
      code: |
        local SEVERITY_NORM = {
          I = 'info', W = 'warning', E = 'error', F = 'fatal', D = 'debug',
          Info = 'info', Warning = 'warning', Error = 'error',
          Fatal = 'fatal', Sys = 'system',
          inf = 'info', err = 'error', cout = 'info'
        }
        function normalize_fields(tag, ts, record)
          local s = record['severity']
          local n = nil
          if s ~= nil then
            n = SEVERITY_NORM[s]
          end
          record['severity_norm'] = n or 'unknown'
          local h = record['hostname']
          if h == nil then
            h = record['host']
          end
          if h ~= nil then
            record['origin_host'] = h
          end
          return 2, ts, record
        end

  outputs:
    - name: opensearch
      match: infologger
      host: localhost
      port: {{ opensearch_http_port }}
      index: infologger
      suppress_type_name: true
      trace_error: true
      storage.total_limit_size: 1M
      retry_limit: 2

    - name: opensearch
      match: family.info
      host: localhost
      port: {{ opensearch_http_port }}
      index: generic-log-info-{{ node_id }}
      suppress_type_name: true
      trace_error: true
      storage.total_limit_size: 1M
      retry_limit: 2

    - name: opensearch
      match: family.other
      host: localhost
      port: {{ opensearch_http_port }}
      index: generic-log-other
      suppress_type_name: true
      trace_error: true
      storage.total_limit_size: 1M
      retry_limit: 2

    - name: opensearch
      match: health
      host: localhost
      port: {{ opensearch_http_port }}
      index: {{ cockpit_metrics_index }}
      suppress_type_name: true
      trace_error: true
      storage.total_limit_size: 512K
      retry_limit: 5
      workers: 0
