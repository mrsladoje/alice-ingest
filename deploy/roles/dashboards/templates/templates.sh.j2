INGEST_PIPELINE=$(cat <<'JSON'
{
  "description": "Stamp ingest_time; ingest_lag_ms = ingest_time - collector_time; enter_system_lag_ms = collector_time - @timestamp.",
  "processors": [
    { "set": { "field": "ingest_time", "value": "{% raw %}{{{_ingest.timestamp}}}{% endraw %}" } },
    {
      "script": {
        "lang": "painless",
        "ignore_failure": true,
        "source": "{% raw %}long toEpochMillis(def v) { if (v == null) { return -1L; } if (v instanceof Number) { long n = ((Number)v).longValue(); return n < 100000000000L ? n * 1000L : n; } String s = v.toString().trim(); if (s.length() == 0) { return -1L; } if (Character.isDigit(s.charAt(0)) && s.indexOf('-') < 0 && s.indexOf('T') < 0 && s.indexOf(' ') < 0) { int dot = s.indexOf('.'); String whole = dot < 0 ? s : s.substring(0, dot); long n = Long.parseLong(whole); return n < 100000000000L ? n * 1000L : n; } if (s.indexOf(' ') >= 0 && s.indexOf('T') < 0) { s = s.replace(' ', 'T'); } if (s.length() >= 19 && s.indexOf('Z') < 0 && s.indexOf('+') < 0 && s.lastIndexOf('-') <= 7) { s = s + 'Z'; } try { return Instant.parse(s).toEpochMilli(); } catch (Exception e1) { try { return Instant.parse(s + 'Z').toEpochMilli(); } catch (Exception e2) { return -1L; } } } if (ctx.collector_time == null) { return; } long collectorMs = toEpochMillis(ctx.collector_time); if (collectorMs < 0) { return; } if (ctx.ingest_time != null) { long ingestMs = toEpochMillis(ctx.ingest_time); if (ingestMs >= 0) { ctx.ingest_lag_ms = ingestMs - collectorMs; } } if (ctx['@timestamp'] != null) { long eventMs = toEpochMillis(ctx['@timestamp']); if (eventMs >= 0) { ctx.enter_system_lag_ms = collectorMs - eventMs; } }{% endraw %}"
      }
    }
  ]
}
JSON
)

