wait_os

# Forbid OpenSearch from auto-creating an index named exactly after a log
# family. Those names belong to rollover write aliases. If ingest reaches one
# while its alias is briefly absent — the seconds between a fresh reload's
# DELETE and this script recreating the aliases, during which Fluent Bit is
# still flushing whatever it had buffered — OpenSearch would helpfully create a
# concrete index with dynamic mapping, which then blocks the alias forever,
# turns collector_time into a long and host into text, and fails the next
# deploy. Rejecting those writes loses a few seconds of records and is strictly
# better. The backing indices (family-000001) are unaffected: they carry a
# suffix so they do not match these exact patterns, and explicit index creation
# is never governed by this setting anyway.
AUTO_CREATE="-infologger,-generic-log-other"
for wn in $WORKER_NODES; do
  AUTO_CREATE="$AUTO_CREATE,-generic-log-info-$wn"
done
AUTO_CREATE="$AUTO_CREATE,+*"
put "/_cluster/settings" \
  "{\"persistent\":{\"action.auto_create_index\":\"$AUTO_CREATE\"}}" \
  "auto-create guard on the log family alias names ($AUTO_CREATE)"

del "/_index_template/alice-logs"         "legacy index template alice-logs"
del "/_index_template/alice-logs-generic" "superseded index template alice-logs-generic"

put "/_ingest/pipeline/alice-add-ingest-time" "$INGEST_PIPELINE" "ingest pipeline alice-add-ingest-time"

put "/_component_template/alice-logs-generic-mappings"    "$GENERIC_MAPPINGS"    "component alice-logs-generic-mappings"
put "/_component_template/alice-logs-infologger-mappings" "$INFOLOGGER_MAPPINGS" "component alice-logs-infologger-mappings"

put "/_index_template/alice-logs-generic-other" "$GENERIC_OTHER_TPL"    "index template alice-logs-generic-other"
put "/_index_template/alice-logs-infologger"    "$INFOLOGGER_INDEX_TPL" "index template alice-logs-infologger"
put "/_index_template/alice-cockpit-metrics"    "$COCKPIT_METRICS_TPL"  "index template alice-cockpit-metrics"
put "/_index_template/alice-trend-rollup"       "$TREND_ROLLUP_TPL"     "index template alice-trend-rollup"
put "/_index_template/alice-anomaly-digest"     "$ANOMALY_DIGEST_TPL"   "index template alice-anomaly-digest"
put "/_index_template/alice-fleet-roster"       "$FLEET_ROSTER_TPL"     "index template alice-fleet-roster"
put "/_index_template/alice-lane-state"         "$LANE_STATE_TPL"       "index template alice-lane-state"
put "/_index_template/alice-signals"            "$SIGNALS_TPL"          "index template alice-signals"
put "/_index_template/alice-incidents"          "$INCIDENTS_TPL"        "index template alice-incidents"
put "/_index_template/alice-notifications"      "$NOTIFICATIONS_TPL"    "index template alice-notifications"

for wn in $WORKER_NODES; do
  put "/_index_template/alice-logs-generic-info-$wn" "$(generic_info_tpl "$wn")" \
    "index template alice-logs-generic-info-$wn"
done

put "/_cluster/settings" "$QUERY_INSIGHTS_SETTINGS" "query insights top-n settings"

for wn in $WORKER_NODES; do
  ensure_rollover_index "generic-log-info-$wn" ""
done

ensure_rollover_index "infologger" ""
ensure_rollover_index "generic-log-other" ""
ensure_index "{{ cockpit_metrics_index }}" '{}'
ensure_index "{{ trend_rollup_index }}" '{}'
ensure_index "{{ anomaly_digest_index }}" '{}'
ensure_index "{{ fleet_roster_index }}" '{}'
ensure_index "{{ lane_state_index }}" '{}'
ensure_index "{{ signals_index }}" '{}'
ensure_index "{{ incidents_index }}" '{}'
ensure_index "{{ notifications_index }}" '{}'

put "/{{ anomaly_digest_index }}/_mapping" "$ANOMALY_DIGEST_FIELDS" "live mapping: provenance + identity fields on {{ anomaly_digest_index }}"
put "/{{ cockpit_metrics_index }}/_mapping" "$COCKPIT_IDENTITY_FIELDS" "live mapping: collector_id/os_node + fleet/projector fields on {{ cockpit_metrics_index }}"
put "/{{ trend_rollup_index }}/_mapping" "$TREND_COMMIT_FIELDS" "live mapping: bucket-commit fields on {{ trend_rollup_index }}"

for idx_tpl in \
  "{{ fleet_roster_index }}:alice-fleet-roster" \
  "{{ lane_state_index }}:alice-lane-state" \
  "{{ signals_index }}:alice-signals" \
  "{{ incidents_index }}:alice-incidents" \
  "{{ notifications_index }}:alice-notifications"; do
  idx="${idx_tpl%%:*}"
  tpl="${idx_tpl##*:}"
  props=$(curl -s $CURL_TIMEOUTS "$OS/_index_template/$tpl" | python3 -c '
import json,sys
try:
    tpl=json.load(sys.stdin)["index_templates"][0]["index_template"]["template"]
    print(json.dumps({"properties": tpl["mappings"]["properties"]}))
except Exception:
    print("")
')
  if [ -n "$props" ]; then
    put "/$idx/_mapping" "$props" "live mapping: $tpl fields on $idx"
  else
    echo "[os-init] FATAL: could not read $tpl to apply its live mapping on $idx"
    exit 1
  fi
done

put "/infologger*/_mapping" "$LAG_MAPPING" "mapping dual-clock lag fields on infologger"
put "/generic-log-other*/_mapping" "$LAG_MAPPING" "mapping dual-clock lag fields on generic-log-other"
for wn in $WORKER_NODES; do
  put "/generic-log-info-$wn*/_mapping" "$LAG_MAPPING" "mapping dual-clock lag fields on generic-log-info-$wn"
done

put "/infologger*/_mapping" "$NORM_MAPPING" "mapping severity_norm/origin_host on infologger"
put "/generic-log-other*/_mapping" "$NORM_MAPPING" "mapping severity_norm/origin_host on generic-log-other"
for wn in $WORKER_NODES; do
  put "/generic-log-info-$wn*/_mapping" "$NORM_MAPPING" "mapping severity_norm/origin_host on generic-log-info-$wn"
done
put "/{{ cockpit_metrics_index }}/_mapping" "$RETRIES_FAILED_DELTA_MAPPING" "mapping output_retries_failed_delta on cockpit-metrics"
put "/infologger*/_mapping" "$POISON_MAPPING" "mapping labelled poison-replay evidence on infologger"
put "/generic-log-other*/_mapping" "$POISON_MAPPING" "mapping labelled poison-replay evidence on generic-log-other"
for wn in $WORKER_NODES; do
  put "/generic-log-info-$wn*/_mapping" "$POISON_MAPPING" "mapping labelled poison-replay evidence on generic-log-info-$wn"
done
put "/{{ cockpit_metrics_index }}/_mapping" "$POISON_MAPPING" "mapping labelled poison-replay evidence on cockpit-metrics"

seed_if_empty "infologger"
seed_if_empty "generic-log-other"
for wn in $WORKER_NODES; do
  seed_if_empty "generic-log-info-$wn"
done

echo "[os-init] DONE — tier-aware mappings, rollover write aliases and all indices in place before first write"
