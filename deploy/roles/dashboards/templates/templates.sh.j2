#!/bin/sh
set -eu

OS="${OS_URL:-http://opensearch:9200}"

WORKER_NODES="{{ groups['workers'] | map('extract', hostvars, 'node_id') | join(' ') }}"
MIGRATE_EXISTING="{{ log_rollover_migrate_existing | bool | ternary('true', 'false') }}"
SEED_EMPTY_INDICES="${SEED_EMPTY_INDICES:-true}"

CURL_TIMEOUTS="--connect-timeout ${OS_CONNECT_TIMEOUT:-5} --max-time ${OS_MAX_TIME:-120}"

wait_os() {
  echo "[os-init] waiting for OpenSearch at $OS ..."
  i=1
  while [ "$i" -le 60 ]; do
    code=$(curl -s --connect-timeout 5 --max-time "${OS_HEALTH_MAX_TIME:-15}" \
      -o /dev/null -w '%{http_code}' \
      "$OS/_cluster/health?wait_for_status=yellow&timeout=5s" || echo 000)
    if [ "$code" = "200" ]; then
      echo "[os-init] OpenSearch ready (attempt $i)"
      return 0
    fi
    echo "[os-init] not ready (HTTP $code), retry $i/60"
    i=$((i + 1))
    sleep 3
  done
  echo "[os-init] FATAL: OpenSearch never became ready"
  return 1
}

put() {
  path="$1"; body="$2"; name="$3"
  i=1
  while [ "$i" -le 5 ]; do
    code=$(curl -s $CURL_TIMEOUTS -o /tmp/resp -w '%{http_code}' \
      -XPUT "$OS$path" -H 'Content-Type: application/json' -d "$body" || echo 000)
    case "$code" in
      200|201) echo "[os-init] applied: $name"; return 0 ;;
      *) echo "[os-init] WARN: $name -> HTTP $code: $(cat /tmp/resp 2>/dev/null); retry $i/5" ;;
    esac
    i=$((i + 1)); sleep 2
  done
  echo "[os-init] FATAL: could not apply $name"
  return 1
}

del() {
  path="$1"; name="$2"
  code=$(curl -s $CURL_TIMEOUTS -o /tmp/resp -w '%{http_code}' -XDELETE "$OS$path" || echo 000)
  case "$code" in
    200|404) echo "[os-init] removed (or absent): $name" ;;
    *) echo "[os-init] WARN: delete $name -> HTTP $code: $(cat /tmp/resp 2>/dev/null)" ;;
  esac
}

ensure_rollover_index() {
  alias="$1"; extra="$2"
  existing=$(curl -s $CURL_TIMEOUTS "$OS/_cat/aliases/$alias?h=index" 2>/dev/null || true)
  if [ -n "$existing" ]; then
    echo "[os-init] write alias already present (skip): $alias -> $existing"
    return 0
  fi
  icode=$(curl -s $CURL_TIMEOUTS -o /dev/null -w '%{http_code}' "$OS/$alias" || echo 000)
  if [ "$icode" = "200" ]; then
    if [ "$MIGRATE_EXISTING" = "true" ]; then
      echo "[os-init] MIGRATING: '$alias' is a legacy concrete index; deleting so the write alias can take the name"
      del "/$alias" "legacy concrete index $alias"
    else
      echo "[os-init] FATAL: '$alias' is a concrete index, not a rollover write alias."
      echo "[os-init] FATAL: Ingest auto-created it before the alias existed, so its fields"
      echo "[os-init] FATAL: come from dynamic mapping instead of the component template:"
      echo "[os-init] FATAL: collector_time lands as long instead of date, host as text"
      echo "[os-init] FATAL: instead of keyword. That breaks the dual-clock mapping applied"
      echo "[os-init] FATAL: later in this script and every terms aggregation on host, and"
      echo "[os-init] FATAL: rollover is inactive for the family. This used to be a warning,"
      echo "[os-init] FATAL: which meant the deploy limped on and died further down with an"
      echo "[os-init] FATAL: unrelated-looking mapper error. Fix it once with:"
      echo "[os-init] FATAL:"
      echo "[os-init] FATAL:   make deploy-migrate-rollover"
      echo "[os-init] FATAL:"
      echo "[os-init] FATAL: which deletes '$alias' and rebuilds it properly. The data in it"
      echo "[os-init] FATAL: is replayable, so this is safe. A fresh replay also self-heals"
      echo "[os-init] FATAL: this now — reset_derived.py drops any log family that is a"
      echo "[os-init] FATAL: concrete index before templates.sh runs."
      return 1
    fi
  fi
  body=$(printf '{"aliases":{"%s":{"is_write_index":true}}%s}' "$alias" "$extra")
  put "/$alias-000001" "$body" "first rollover index $alias-000001 (write alias $alias)"
}

ensure_alert_actions_alias() {
  alias="alice-alert-actions"
  first="$alias-000001"
  existing=$(curl -s $CURL_TIMEOUTS "$OS/_cat/aliases/$alias?h=index" 2>/dev/null || true)
  if [ -n "$existing" ]; then
    echo "[os-init] write alias already present (skip): $alias -> $existing"
    return 0
  fi
  icode=$(curl -s $CURL_TIMEOUTS -o /dev/null -w '%{http_code}' "$OS/$alias" || echo 000)
  if [ "$icode" != "200" ]; then
    ensure_rollover_index "$alias" ""
    return 0
  fi
  echo "[os-init] MIGRATING: '$alias' is a legacy concrete index and nothing bounds its size"
  fcode=$(curl -s $CURL_TIMEOUTS -o /dev/null -w '%{http_code}' "$OS/$first" || echo 000)
  if [ "$fcode" = "200" ]; then
    echo "[os-init] $first already exists (resuming an interrupted migration)"
  else
    put "/$first" '{}' "first rollover index $first"
  fi
  code=$(curl -s --connect-timeout "${OS_CONNECT_TIMEOUT:-5}" \
    --max-time "${ALERT_ACTIONS_REINDEX_MAX_TIME:-600}" \
    -o /tmp/os-alert-reindex -w '%{http_code}' \
    -XPOST "$OS/_reindex?wait_for_completion=true&refresh=true" \
    -H 'Content-Type: application/json' \
    -d "{\"source\":{\"index\":\"$alias\"},\"dest\":{\"index\":\"$first\"}}" || echo 000)
  moved=$(python3 -c '
import json,sys
try:
    r=json.load(open("/tmp/os-alert-reindex"))
except Exception:
    print("-1"); raise SystemExit
if r.get("failures") or r.get("timed_out"):
    print("-1")
else:
    print(int(r.get("created",0))+int(r.get("updated",0)))
' 2>/dev/null || echo -1)
  if [ "$code" != "200" ] || [ "$moved" = "-1" ]; then
    echo "[os-init] FATAL: reindex $alias -> $first HTTP $code: $(cat /tmp/os-alert-reindex 2>/dev/null)"
    echo "[os-init] FATAL: the legacy index is untouched, and re-running this is safe"
    echo "[os-init] FATAL: because reindex keeps document ids. Retry, or delete the"
    echo "[os-init] FATAL: legacy index by hand if its history is not worth keeping."
    return 1
  fi
  echo "[os-init] reindexed $alias -> $first ($moved documents)"
  del "/$alias" "legacy concrete index $alias (its records now live in $first)"
  code=$(curl -s $CURL_TIMEOUTS -o /tmp/os-alert-alias -w '%{http_code}' \
    -XPOST "$OS/_aliases" -H 'Content-Type: application/json' \
    -d "{\"actions\":[{\"add\":{\"index\":\"$first\",\"alias\":\"$alias\",\"is_write_index\":true}}]}" \
    || echo 000)
  case "$code" in
    200|201) echo "[os-init] applied: write alias $alias -> $first" ;;
    *)
      echo "[os-init] FATAL: alias $alias -> $first HTTP $code: $(cat /tmp/os-alert-alias 2>/dev/null)"
      return 1
      ;;
  esac
}

seed_if_empty() {
  alias="$1"
  if [ "$SEED_EMPTY_INDICES" != "true" ]; then
    return 0
  fi
  cnt=$(curl -s $CURL_TIMEOUTS "$OS/$alias/_count?ignore_unavailable=true&allow_no_indices=true" \
    | python3 -c '
import json,sys
try:
    print(int(json.load(sys.stdin).get("count", 0)))
except Exception:
    print(-1)
')
  if [ "$cnt" = "-1" ]; then
    echo "[os-init] FATAL: could not count documents in $alias"
    return 1
  fi
  if [ "$cnt" != "0" ]; then
    echo "[os-init] $alias holds $cnt documents (no bootstrap seed needed)"
    return 0
  fi
  now=$(date -u +%Y-%m-%dT%H:%M:%S.000Z)
  body=$(printf '{"@timestamp":"%s","collector_time":"%s","log_source":"bootstrap","message":"alice-ingest bootstrap seed. The anomaly-detection plugin refuses to create or update a detector over an index holding zero documents, and the log indices stay empty until the first replay. This document exists only for the moment between index creation and detector provisioning, and the deploy deletes it again once every detector is up. It carries no host, node or severity field, so it forms no entity in any detector or trend-rollup bucket."}' "$now" "$now")
  code=$(curl -s $CURL_TIMEOUTS -o /tmp/os-seed -w '%{http_code}' \
    -XPUT "$OS/$alias/_doc/alice-bootstrap-seed?refresh=true" \
    -H 'Content-Type: application/json' -d "$body" || echo 000)
  case "$code" in
    200|201) echo "[os-init] seeded 1 bootstrap document into $alias" ;;
    *)
      echo "[os-init] FATAL: seed $alias -> HTTP $code: $(cat /tmp/os-seed)"
      return 1
      ;;
  esac
}

ensure_index() {
  idx="$1"; body="$2"
  code=$(curl -s $CURL_TIMEOUTS -o /dev/null -w '%{http_code}' "$OS/$idx" || echo 000)
  if [ "$code" = "200" ]; then
    echo "[os-init] index already present (skip create): $idx"
    return 0
  fi
  put "/$idx" "$body" "index $idx"
}

