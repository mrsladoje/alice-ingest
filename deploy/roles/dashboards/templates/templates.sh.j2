# The worker-tier template and write alias live in register_node.sh, which each
# worker also runs as ExecStartPre. Called here too, because the detectors
# provisioned later in this play cannot wait for the collectors to start.
REGISTER_NODE="$(dirname "$0")/register_node.sh"

# Bulk fan-out spreads across primaries instead of funnelling through the one
# node that holds a single primary. Pinned low here by shard budget, not by
# design — see log_primary_shards_storage in group_vars/all.yml.
