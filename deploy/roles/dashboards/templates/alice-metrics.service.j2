# {{ ansible_managed }}
[Unit]
Description=ALICE Cockpit metrics poller — control node
After=network-online.target opensearch.service opensearch-dashboards.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=OSD_URL=http://127.0.0.1:{{ dashboards_internal_port }}
Environment=FB_TARGETS={% for h in groups['workers'] %}{{ hostvars[h].node_id }}=http://{{ hostvars[h].ansible_host }}:{{ fluent_bit_http_port }}{% if not loop.last %},{% endif %}{% endfor %}
Environment=INFO_NODES={% for h in groups['workers'] %}{{ hostvars[h].node_id }}{% if not loop.last %},{% endif %}{% endfor %}
Environment=METRICS_INDEX={{ cockpit_metrics_index }}
Environment=INTERVAL={{ cockpit_metrics_interval_seconds }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ dashboards_metrics_script }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
