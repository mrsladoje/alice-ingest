# {{ ansible_managed }}
[Unit]
Description=ALICE Cockpit ops trigger (replay button) — control node
After=network-online.target opensearch.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=OPS_PORT={{ ops_internal_port }}
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=OPS_WORKER_TRIGGERS={% for h in groups['workers'] %}http://{{ hostvars[h].ansible_host }}:{{ replay_http_port }}{% if not loop.last %},{% endif %}{% endfor +%}
Environment=OPS_WORKER_INFO_NODES={{ groups['workers'] | map('extract', hostvars, 'node_id') | join(',') }}
Environment=OPS_REPLAY_FAMILIES=infologger,dds,stdout
Environment=OPS_TEMPLATES_SCRIPT={{ dashboards_bootstrap_templates_script }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ dashboards_ops_script }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
