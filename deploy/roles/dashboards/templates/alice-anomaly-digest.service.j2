# {{ ansible_managed }}
[Unit]
Description=ALICE Cockpit anomaly digest — readable anomaly records for the cockpit
After=network-online.target opensearch.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=DIGEST_INDEX={{ anomaly_digest_index }}
Environment=INTERVAL={{ anomaly_digest_interval_seconds }}
Environment=LOOKBACK={{ anomaly_digest_lookback }}
Environment=GRADE_FLOOR={{ anomaly_digest_grade_floor }}
Environment=RETENTION_DAYS={{ anomaly_digest_retention_days }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ dashboards_anomaly_digest_script }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
