#!/bin/sh
set -eu

OS="${OS_URL:-http://localhost:9200}"
MONITORS_DIR="${MONITORS_DIR:-/opt/alice-ingest/init/monitors}"
GRADE="${AD_ANOMALY_GRADE_THRESHOLD:-0.7}"
CONF="${AD_ANOMALY_CONFIDENCE_THRESHOLD:-0.7}"
LAG_FLOOR="${TREND_LAG_FLOOR_MS:-250}"
LAG_CEILING="${TREND_ENTRY_LAG_CEILING_MS:-3600000}"
ENTITY_CAP="${TREND_ENTITY_CAP:-1800}"
MIN_SLICE_DOCS="${TREND_MIN_SLICE_DOCS:-50}"
MIN_SLICE_ERRORS="${TREND_MIN_SLICE_ERRORS:-10}"
MIN_LAG_DOCS="${TREND_MIN_LAG_DOCS:-100}"
FLEET_SILENCE_FRACTION="${FLEET_SILENCE_FRACTION:-0.5}"
DISK_FORECAST_THRESHOLD="${FORECAST_DISK_THRESHOLD_PERCENT:-85}"
SINK_ID="${ALERT_SINK_ID:-alice-incluster-alert-sink}"
SINK_URL="${ALERT_SINK_URL:-http://127.0.0.1:9200/alice-alert-actions/_doc}"
SINK_INDEX="${ALERT_SINK_INDEX:-alice-alert-actions}"
BREAKGLASS_ID="${BREAKGLASS_SINK_ID:-alice-breakglass-sink}"
BREAKGLASS_URL="${BREAKGLASS_SINK_URL:-http://127.0.0.1:8091/notifications}"
MAX_ACTIONABLE="${ALERTING_MAX_ACTIONABLE_ALERT_COUNT:-50}"

put_ok() {
  case "$1" in
    200|201) return 0 ;;
    *) return 1 ;;
  esac
}

pin_actionable_limit() {
  code=$(curl -s -o /tmp/alert-limit -w '%{http_code}' \
    -XPUT "$OS/_cluster/settings" -H 'Content-Type: application/json' \
    -d "{\"persistent\":{\"plugins.alerting.max_actionable_alert_count\":$MAX_ACTIONABLE}}" \
    || echo 000)
  if put_ok "$code"; then
    echo "[alerting] pinned plugins.alerting.max_actionable_alert_count=$MAX_ACTIONABLE"
  else
    echo "[alerting] FATAL: pin actionable-alert limit -> HTTP $code: $(cat /tmp/alert-limit)"
    return 1
  fi
}

ensure_alert_sink_index() {
  code=$(curl -s -o /tmp/alert-sink-idx -w '%{http_code}' \
    -XPUT "$OS/$SINK_INDEX" \
    -H 'Content-Type: application/json' \
    -d '{
      "settings": {"number_of_shards": 1, "number_of_replicas": 0},
      "mappings": {
        "properties": {
          "monitor": {"type": "keyword"},
          "trigger": {"type": "keyword"},
          "severity": {"type": "keyword"},
          "period_end": {"type": "keyword"}
        }
      }
    }' || echo 000)
  case "$code" in
    200|201)
      echo "[alerting] ensured index: $SINK_INDEX"
      ;;
    400)
      if grep -q 'resource_already_exists_exception' /tmp/alert-sink-idx 2>/dev/null; then
        echo "[alerting] index exists: $SINK_INDEX"
      else
        echo "[alerting] FATAL: create index $SINK_INDEX -> HTTP $code: $(cat /tmp/alert-sink-idx)"
        return 1
      fi
      ;;
    *)
      echo "[alerting] FATAL: create index $SINK_INDEX -> HTTP $code: $(cat /tmp/alert-sink-idx)"
      return 1
      ;;
  esac
  code=$(curl -s -o /tmp/alert-sink-map -w '%{http_code}' \
    -XPUT "$OS/$SINK_INDEX/_mapping" -H 'Content-Type: application/json' \
    -d '{
      "properties": {
        "entity": {"type": "keyword"},
        "entity_kind": {"type": "keyword"},
        "notification_scope": {"type": "keyword"},
        "feed": {"type": "keyword"},
        "delivery_path": {"type": "keyword"},
        "period_start": {"type": "keyword"}
      }
    }' || echo 000)
  if put_ok "$code"; then
    echo "[alerting] live mapping applied on $SINK_INDEX (entity + scope fields)"
  else
    echo "[alerting] FATAL: mapping $SINK_INDEX -> HTTP $code: $(cat /tmp/alert-sink-map)"
    return 1
  fi
}

upsert_channel() {
  SINK_ID="$1"; SINK_URL="$2"; SINK_DESC="$3"
  body=$(SINK_ID="$SINK_ID" SINK_URL="$SINK_URL" SINK_DESC="$SINK_DESC" python3 -c '
import json,os
print(json.dumps({
  "config_id": os.environ["SINK_ID"],
  "config": {
    "name": os.environ["SINK_ID"],
    "description": os.environ["SINK_DESC"],
    "config_type": "webhook",
    "is_enabled": True,
    "webhook": {
      "url": os.environ["SINK_URL"],
      "header_params": {"Content-Type": "application/json"},
    },
  },
}))
')
  gcode=$(curl -s -o /tmp/alert-sink-get -w '%{http_code}' \
    "$OS/_plugins/_notifications/configs/$SINK_ID" || echo 000)
  if [ "$gcode" = "200" ] && grep -q "$SINK_ID" /tmp/alert-sink-get 2>/dev/null; then
    up_body=$(printf '%s' "$body" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(json.dumps({"config": d["config"]}))')
    code=$(curl -s -o /tmp/alert-sink-resp -w '%{http_code}' \
      -XPUT "$OS/_plugins/_notifications/configs/$SINK_ID" \
      -H 'Content-Type: application/json' -d "$up_body" || echo 000)
    if put_ok "$code"; then
      echo "[alerting] updated notification channel: $SINK_ID"
    else
      echo "[alerting] FATAL: update channel $SINK_ID -> HTTP $code: $(cat /tmp/alert-sink-resp)"
      return 1
    fi
  else
    code=$(curl -s -o /tmp/alert-sink-resp -w '%{http_code}' \
      -XPOST "$OS/_plugins/_notifications/configs/" \
      -H 'Content-Type: application/json' -d "$body" || echo 000)
    if put_ok "$code"; then
      echo "[alerting] created notification channel: $SINK_ID"
    else
      echo "[alerting] FATAL: create channel $SINK_ID -> HTTP $code: $(cat /tmp/alert-sink-resp)"
      return 1
    fi
  fi
}

search_monitor_id() {
  name="$1"
  curl -s -XPOST "$OS/_plugins/_alerting/monitors/_search" \
    -H 'Content-Type: application/json' \
    -d "{\"query\":{\"bool\":{\"should\":[{\"term\":{\"monitor.name.keyword\":\"$name\"}},{\"term\":{\"monitor.name\":\"$name\"}},{\"match_phrase\":{\"monitor.name\":\"$name\"}}]}},\"size\":5}" \
    | python3 -c '
import json,sys
name=sys.argv[1]
r=json.load(sys.stdin)
for h in r.get("hits",{}).get("hits",[]):
    src=h.get("_source",{})
    mon=src.get("monitor",src)
    if mon.get("name")==name:
        print(h["_id"])
        break
' "$name"
}

prepare_body() {
  file="$1"
  GRADE="$GRADE" CONF="$CONF" LAG_FLOOR="$LAG_FLOOR" \
  ENTITY_CAP="$ENTITY_CAP" LAG_CEILING="$LAG_CEILING" \
  MIN_SLICE_DOCS="$MIN_SLICE_DOCS" MIN_SLICE_ERRORS="$MIN_SLICE_ERRORS" \
  MIN_LAG_DOCS="$MIN_LAG_DOCS" FLEET_SILENCE_FRACTION="$FLEET_SILENCE_FRACTION" \
  DISK_FORECAST_THRESHOLD="$DISK_FORECAST_THRESHOLD" \
  python3 -c '
import json,os,re,sys
d=json.load(open(sys.argv[1]))
name=d.get("name")
if name=="disk-fill-forecast":
    threshold=float(os.environ["DISK_FORECAST_THRESHOLD"])
    trig=d["triggers"][0]["query_level_trigger"]
    trig["condition"]["script"]["source"]=re.sub(
        r"double diskThreshold = [0-9.]+;",
        "double diskThreshold = %r;" % threshold,
        trig["condition"]["script"]["source"])
if name=="fleet-fb-silence":
    frac=float(os.environ["FLEET_SILENCE_FRACTION"])
    trig=d["triggers"][0]["query_level_trigger"]
    trig["condition"]["script"]["source"]=re.sub(
        r"double fleetSilenceFraction = [0-9.]+;",
        "double fleetSilenceFraction = %r;" % frac,
        trig["condition"]["script"]["source"])
if name=="ad-high-grade":
    grade=os.environ["GRADE"]
    conf=os.environ["CONF"]
    trig=d["triggers"][0]["query_level_trigger"]
    src=trig["condition"]["script"]["source"]
    src=re.sub(r"max_anomaly_grade\.value > [0-9.]+",
               "max_anomaly_grade.value > "+grade, src)
    src=re.sub(r"confidence > [0-9.]+",
               "confidence > "+conf, src)
    trig["condition"]["script"]["source"]=src
if name and name.startswith("trend-"):
    floor=float(os.environ["LAG_FLOOR"])
    cap=float(os.environ["ENTITY_CAP"])
    ceiling=float(os.environ["LAG_CEILING"])
    mindocs=float(os.environ["MIN_SLICE_DOCS"])
    minerrs=float(os.environ["MIN_SLICE_ERRORS"])
    minlagdocs=float(os.environ["MIN_LAG_DOCS"])
    for t in d.get("triggers") or []:
        trig=t.get("bucket_level_trigger") or t.get("query_level_trigger")
        if not trig:
            continue
        src=trig["condition"]["script"]["source"]
        src=re.sub(r"double lagFloor = [0-9.]+;",
                   "double lagFloor = %r;" % floor, src)
        src=re.sub(r"double lagCeiling = [0-9.]+;",
                   "double lagCeiling = %r;" % ceiling, src)
        src=re.sub(r"double entityCap = [0-9.]+;",
                   "double entityCap = %r;" % cap, src)
        src=re.sub(r"double minDocs = [0-9.]+;",
                   "double minDocs = %r;" % mindocs, src)
        src=re.sub(r"double minLagDocs = [0-9.]+;",
                   "double minLagDocs = %r;" % minlagdocs, src)
        src=re.sub(r"double minEf = [0-9.]+;",
                   "double minEf = %r;" % minerrs, src)
        trig["condition"]["script"]["source"]=src
print(json.dumps(d))
' "$file"
}

upsert_monitor() {
  file="$1"
  body=$(prepare_body "$file")
  name=$(printf '%s' "$body" | python3 -c 'import json,sys; print(json.load(sys.stdin)["name"])')
  existing=$(search_monitor_id "$name")
  if [ -n "$existing" ]; then
    code=$(curl -s -o /tmp/monitor-resp -w '%{http_code}' \
      -XPUT "$OS/_plugins/_alerting/monitors/$existing" \
      -H 'Content-Type: application/json' -d "$body" || echo 000)
    if put_ok "$code"; then
      echo "[alerting] updated monitor: $name ($existing)"
    else
      echo "[alerting] FATAL: update $name -> HTTP $code: $(cat /tmp/monitor-resp)"
      return 1
    fi
  else
    code=$(curl -s -o /tmp/monitor-resp -w '%{http_code}' \
      -XPOST "$OS/_plugins/_alerting/monitors" \
      -H 'Content-Type: application/json' -d "$body" || echo 000)
    if put_ok "$code"; then
      echo "[alerting] created monitor: $name"
    else
      echo "[alerting] FATAL: create $name -> HTTP $code: $(cat /tmp/monitor-resp)"
      return 1
    fi
  fi
}

echo "[alerting] provisioning alert sinks + monitors from $MONITORS_DIR"
pin_actionable_limit
ensure_alert_sink_index
upsert_channel "$SINK_ID" "$SINK_URL" \
  "In-cluster webhook sink for alert action throttle (indexes into alice-alert-actions)"
upsert_channel "$BREAKGLASS_ID" "$BREAKGLASS_URL" \
  "Break-glass sink for the two dead-man monitors only (signal-projector-stale, alertmanager-down). It deliberately bypasses the projector and Alertmanager, because those are the components it reports dead. Nothing else may use it."
count=0
for f in "$MONITORS_DIR"/*.json; do
  [ -f "$f" ] || continue
  upsert_monitor "$f"
  count=$((count + 1))
done
if [ "$count" -lt 1 ]; then
  echo "[alerting] FATAL: no monitor definitions in $MONITORS_DIR"
  exit 1
fi
echo "[alerting] DONE — $count monitors upserted (sink=$SINK_ID)"
