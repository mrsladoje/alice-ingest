#!/bin/sh
set -eu

OS="${OS_URL:-http://localhost:9200}"
DETECTORS_DIR="${DETECTORS_DIR:-/opt/alice-ingest/init/detectors}"
METRICS_DELAY="${AD_METRICS_WINDOW_DELAY_MINUTES:-1}"
LOG_DELAY="${AD_LOG_WINDOW_DELAY_MINUTES:-2}"

METRICS_NAMES="ingest-flow node-health dashboards-health"

put_ok() {
  case "$1" in
    200|201) return 0 ;;
    *) return 1 ;;
  esac
}

search_detector_id() {
  name="$1"
  curl -s -XPOST "$OS/_plugins/_anomaly_detection/detectors/_search" \
    -H 'Content-Type: application/json' \
    -d "{\"query\":{\"bool\":{\"should\":[{\"term\":{\"name.keyword\":\"$name\"}},{\"term\":{\"name\":\"$name\"}},{\"match_phrase\":{\"name\":\"$name\"}}]}},\"size\":5}" \
    | python3 -c '
import json,sys
name=sys.argv[1]
r=json.load(sys.stdin)
for h in r.get("hits",{}).get("hits",[]):
    if h.get("_source",{}).get("name")==name:
        print(h["_id"])
        break
' "$name"
}

prepare_body() {
  file="$1"
  name=$(basename "$file" .json)
  delay="$LOG_DELAY"
  case " $METRICS_NAMES " in
    *" $name "*) delay="$METRICS_DELAY" ;;
  esac
  python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
d["window_delay"]={"period":{"interval":int(sys.argv[2]),"unit":"Minutes"}}
print(json.dumps(d))
' "$file" "$delay"
}

CMP='
import json, sys

KEYS = ["name", "description", "time_field", "indices", "shingle_size",
        "category_field", "detection_interval", "window_delay",
        "imputation_option", "filter_query", "result_index", "rules"]

NOISE = {"boost": 1.0, "adjust_pure_negative": True}


def strip(v):
    if isinstance(v, dict):
        out = {}
        for k, x in v.items():
            if x is None:
                continue
            if k in NOISE and x == NOISE[k]:
                continue
            out[k] = strip(x)
        if list(out) == ["value"]:
            return out["value"]
        return out
    if isinstance(v, list):
        return [strip(x) for x in v]
    return v


MATCH_ALL = json.dumps(strip({"match_all": {"boost": 1.0}}), sort_keys=True)


def feats(d):
    out = []
    for f in d.get("feature_attributes") or []:
        out.append([f.get("feature_name"),
                    bool(f.get("feature_enabled", True)),
                    strip(f.get("aggregation_query"))])
    return out


def norm(d, ref):
    n = {}
    for k in KEYS:
        if k not in d:
            continue
        v = strip(d[k])
        if k not in ref:
            if v in (None, [], {}):
                continue
            if k == "filter_query" and json.dumps(v, sort_keys=True) == MATCH_ALL:
                continue
        if k in ("indices", "category_field") and isinstance(v, list):
            v = sorted(v)
        n[k] = v
    n["features"] = feats(d)
    return json.dumps(n, sort_keys=True)


desired = json.load(open(sys.argv[1]))
current = json.load(open(sys.argv[2]))
det = current.get("anomaly_detector") or {}
job = current.get("anomaly_detector_job") or {}
if not det:
    print("changed")
elif norm(det, desired) != norm(desired, desired):
    print("changed")
elif job.get("enabled"):
    print("same-running")
else:
    print("same-stopped")
'

stop_detector() {
  id="$1"
  curl -s -o /tmp/ad-stop -w '%{http_code}' \
    -XPOST "$OS/_plugins/_anomaly_detection/detectors/$id/_stop" || echo 000
}

start_detector() {
  id="$1"
  code=$(curl -s -o /tmp/ad-start -w '%{http_code}' \
    -XPOST "$OS/_plugins/_anomaly_detection/detectors/$id/_start" || echo 000)
  case "$code" in
    200|201) echo "[detectors] started: $id" ;;
    *)
      echo "[detectors] FATAL: start $id -> HTTP $code: $(cat /tmp/ad-start)"
      return 1
      ;;
  esac
}

upsert_detector() {
  file="$1"
  prepare_body "$file" > /tmp/ad-desired.json
  name=$(python3 -c 'import json; print(json.load(open("/tmp/ad-desired.json"))["name"])')
  existing=$(search_detector_id "$name")

  if [ -z "$existing" ]; then
    code=$(curl -s -o /tmp/ad-resp -w '%{http_code}' \
      -XPOST "$OS/_plugins/_anomaly_detection/detectors" \
      -H 'Content-Type: application/json' \
      --data-binary @/tmp/ad-desired.json || echo 000)
    if put_ok "$code"; then
      id=$(python3 -c 'import json; print(json.load(open("/tmp/ad-resp")).get("_id",""))')
      echo "[detectors] created: $name ($id)"
      if [ -n "$id" ]; then
        start_detector "$id"
      fi
      return 0
    fi
    echo "[detectors] FATAL: create $name -> HTTP $code: $(cat /tmp/ad-resp)"
    return 1
  fi

  curl -s -o /tmp/ad-current.json \
    "$OS/_plugins/_anomaly_detection/detectors/$existing?job=true" || true
  state=$(python3 -c "$CMP" /tmp/ad-desired.json /tmp/ad-current.json \
    2>/dev/null || echo changed)

  case "$state" in
    same-running)
      echo "[detectors] unchanged and running, model state preserved: $name ($existing)"
      return 0
      ;;
    same-stopped)
      echo "[detectors] unchanged but stopped: $name ($existing)"
      start_detector "$existing"
      return 0
      ;;
  esac

  echo "[detectors] definition changed, restarting (RCF models and init progress reset): $name ($existing)"
  stop_detector "$existing" >/dev/null || true
  sleep 2
  code=$(curl -s -o /tmp/ad-resp -w '%{http_code}' \
    -XPUT "$OS/_plugins/_anomaly_detection/detectors/$existing" \
    -H 'Content-Type: application/json' \
    --data-binary @/tmp/ad-desired.json || echo 000)
  if ! put_ok "$code"; then
    sleep 3
    stop_detector "$existing" >/dev/null || true
    sleep 2
    code=$(curl -s -o /tmp/ad-resp -w '%{http_code}' \
      -XPUT "$OS/_plugins/_anomaly_detection/detectors/$existing" \
      -H 'Content-Type: application/json' \
      --data-binary @/tmp/ad-desired.json || echo 000)
  fi
  if put_ok "$code"; then
    echo "[detectors] updated: $name ($existing)"
    start_detector "$existing"
  else
    echo "[detectors] FATAL: update $name -> HTTP $code: $(cat /tmp/ad-resp)"
    return 1
  fi
}

delete_detector_by_name() {
  name="$1"
  existing=$(search_detector_id "$name")
  if [ -z "$existing" ]; then
    return 0
  fi
  stop_detector "$existing" >/dev/null || true
  sleep 1
  code=$(curl -s -o /tmp/ad-del -w '%{http_code}' \
    -XDELETE "$OS/_plugins/_anomaly_detection/detectors/$existing" || echo 000)
  case "$code" in
    200|201|404)
      echo "[detectors] deleted obsolete: $name ($existing)"
      ;;
    *)
      echo "[detectors] FATAL: delete obsolete $name -> HTTP $code: $(cat /tmp/ad-del)"
      return 1
      ;;
  esac
}

echo "[detectors] provisioning from $DETECTORS_DIR (metrics_delay=${METRICS_DELAY}m log_delay=${LOG_DELAY}m)"
curl -s -XPUT "$OS/_cluster/settings" -H 'Content-Type: application/json' \
  -d '{"persistent":{"plugins.anomaly_detection.max_multi_entity_anomaly_detectors":50}}' \
  >/tmp/ad-settings || true
delete_detector_by_name "il-per-epn-lag"
count=0
for f in "$DETECTORS_DIR"/*.json; do
  [ -f "$f" ] || continue
  upsert_detector "$f"
  count=$((count + 1))
done
if [ "$count" -lt 1 ]; then
  echo "[detectors] FATAL: no detector definitions in $DETECTORS_DIR"
  exit 1
fi
echo "[detectors] DONE — $count detectors upserted and start requested"
