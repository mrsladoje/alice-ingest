# {{ ansible_managed }}
[Unit]
Description=ALICE signal projector — domain semantics for alerts and anomalies
After=network-online.target opensearch.service alertmanager.service
Wants=network-online.target

[Service]
Type=simple
MemoryAccounting=yes
MemoryHigh={{ alice_service_memory_high }}
MemoryMax={{ alice_service_memory_max }}
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=ALERTMANAGER_URL=http://127.0.0.1:{{ alertmanager_port }}
Environment=SIGNALS_INDEX={{ signals_index }}
Environment=INCIDENTS_INDEX={{ incidents_index }}
Environment=NOTIFICATIONS_INDEX={{ notifications_index }}
Environment=METRICS_INDEX={{ cockpit_metrics_index }}
Environment=ROSTER_INDEX={{ fleet_roster_index }}
Environment=STATE_INDEX={{ lane_state_index }}
Environment=SIGNAL_CATALOG={{ dashboards_bootstrap_signal_catalog }}
Environment=CLUSTER_ID={{ cluster_id }}
Environment=INTERVAL={{ signal_projector_interval_seconds }}
Environment=RESOLVE_TIMEOUT_SECONDS={{ signal_projector_resolve_timeout_seconds }}
Environment=GRADE_FLOOR={{ anomaly_grade_floor }}
Environment=OVERLAP_MINUTES={{ anomaly_digest_overlap_minutes }}
Environment=INITIAL_LOOKBACK_MINUTES={{ anomaly_digest_initial_lookback_minutes }}
Environment=PAGE={{ signal_projector_page }}
Environment=RETENTION_DAYS={{ signal_projector_retention_days }}
Environment=MASS_SILENCE_FRACTION={{ signal_projector_mass_silence_fraction }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ dashboards_signal_projector_script }}
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
