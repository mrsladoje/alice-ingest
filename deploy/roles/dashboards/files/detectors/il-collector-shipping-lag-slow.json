{
  "name": "il-collector-shipping-lag-slow",
  "description": "InfoLogger per-collector ingest_lag_ms 30m",
  "time_field": "collector_time",
  "indices": [
    "infologger"
  ],
  "category_field": [
    "node"
  ],
  "feature_attributes": [
    {
      "feature_name": "avg_shipping_lag",
      "feature_enabled": true,
      "aggregation_query": {
        "avg_shipping_lag": {
          "avg": {
            "field": "ingest_lag_ms"
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 30,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 2,
      "unit": "Minutes"
    }
  },
  "shingle_size": 8
}
