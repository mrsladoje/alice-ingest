{
  "name": "il-per-epn-entry-lag",
  "description": "InfoLogger per-EPN enter_system_lag_ms (archive-age under preserved replay)",
  "time_field": "collector_time",
  "indices": [
    "infologger"
  ],
  "category_field": [
    "hostname"
  ],
  "feature_attributes": [
    {
      "feature_name": "avg_entry_lag",
      "feature_enabled": true,
      "aggregation_query": {
        "avg_entry_lag": {
          "avg": {
            "field": "enter_system_lag_ms"
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 1,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 2,
      "unit": "Minutes"
    }
  },
  "shingle_size": 8
}
