{
  "name": "info-collector-shipping-lag",
  "description": "generic-log-info per-collector p95(ingest_lag_ms)",
  "time_field": "collector_time",
  "indices": [
    "generic-log-info-*"
  ],
  "category_field": [
    "node"
  ],
  "feature_attributes": [
    {
      "feature_name": "p95_shipping_lag",
      "feature_enabled": true,
      "aggregation_query": {
        "p95_shipping_lag": {
          "percentiles": {
            "field": "ingest_lag_ms",
            "percents": [
              95
            ]
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 1,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 2,
      "unit": "Minutes"
    }
  },
  "shingle_size": 8
}
