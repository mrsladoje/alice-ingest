{
  "name": "il-per-epn-slow",
  "description": "InfoLogger per-EPN volume errors 30m",
  "time_field": "collector_time",
  "indices": [
    "infologger"
  ],
  "feature_attributes": [
    {
      "feature_name": "volume",
      "feature_enabled": true,
      "aggregation_query": {
        "volume": {
          "value_count": {
            "field": "@timestamp"
          }
        }
      }
    },
    {
      "feature_name": "ef_count",
      "feature_enabled": true,
      "aggregation_query": {
        "ef_count": {
          "sum": {
            "script": {
              "lang": "painless",
              "source": "doc.containsKey('severity_norm') && doc['severity_norm'].size() != 0 && (doc['severity_norm'].value == 'error' || doc['severity_norm'].value == 'fatal') ? 1.0 : 0.0"
            }
          }
        }
      }
    }
  ],
  "detection_interval": {
    "period": {
      "interval": 30,
      "unit": "Minutes"
    }
  },
  "window_delay": {
    "period": {
      "interval": 2,
      "unit": "Minutes"
    }
  },
  "shingle_size": 8,
  "category_field": [
    "origin_host"
  ],
  "imputation_option": {
    "method": "ZERO"
  }
}
