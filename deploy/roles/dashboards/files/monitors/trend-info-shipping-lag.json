{
  "type": "monitor",
  "name": "trend-info-shipping-lag",
  "description": "Warn when generic-log-info per-node avg(ingest_lag_ms) rises. Dwell: fire only if breach sustained across 3 consecutive 10m slices (~30m). Ratio 2x rising (volume also <=0.5x collapse - all three slices same direction). Baseline: 7d excluding last 30m; 24h fallback when 7d empty. Schedule 10m. Throttle 30m per alert key via alice-incluster-alert-sink.",
  "monitor_type": "bucket_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 10,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "generic-log-info-*"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "collector_time": {
                      "gte": "{{period_end}}||-7d",
                      "lte": "{{period_end}}",
                      "format": "epoch_millis"
                    }
                  }
                }
              ]
            }
          },
          "aggregations": {
            "composite_agg": {
              "composite": {
                "size": 1000,
                "sources": [
                  {
                    "node": {
                      "terms": {
                        "field": "node"
                      }
                    }
                  }
                ]
              },
              "aggregations": {
                "slice0": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-10m",
                        "lte": "{{period_end}}",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "avg_lag": {
                      "avg": {
                        "field": "ingest_lag_ms"
                      }
                    }
                  }
                },
                "slice1": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-20m",
                        "lt": "{{period_end}}||-10m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "avg_lag": {
                      "avg": {
                        "field": "ingest_lag_ms"
                      }
                    }
                  }
                },
                "slice2": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-30m",
                        "lt": "{{period_end}}||-20m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "avg_lag": {
                      "avg": {
                        "field": "ingest_lag_ms"
                      }
                    }
                  }
                },
                "baseline_7d": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-7d",
                        "lt": "{{period_end}}||-30m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "avg_lag": {
                      "avg": {
                        "field": "ingest_lag_ms"
                      }
                    }
                  }
                },
                "baseline_24h": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-24h",
                        "lt": "{{period_end}}||-30m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "avg_lag": {
                      "avg": {
                        "field": "ingest_lag_ms"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "bucket_level_trigger": {
        "name": "trend-info-shipping-lag",
        "severity": "2",
        "condition": {
          "buckets_path": {
            "slice0": "slice0>avg_lag",
            "slice1": "slice1>avg_lag",
            "slice2": "slice2>avg_lag",
            "baseline_7d": "baseline_7d>avg_lag",
            "baseline_24h": "baseline_24h>avg_lag"
          },
          "parent_bucket_path": "composite_agg",
          "script": {
            "source": "if (params.slice0 == null || params.slice1 == null || params.slice2 == null) { return false; } if (params.slice0 <= 0 || params.slice1 <= 0 || params.slice2 <= 0) { return false; } double base = (params.baseline_7d != null && params.baseline_7d > 0) ? params.baseline_7d : ((params.baseline_24h != null) ? params.baseline_24h : 0); if (base <= 0) { return false; } return (params.slice0 / base) >= 2.0 && (params.slice1 / base) >= 2.0 && (params.slice2 / base) >= 2.0;",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "notify",
            "destination_id": "alice-incluster-alert-sink",
            "subject_template": {
              "source": "{{ctx.monitor.name}}",
              "lang": "mustache"
            },
            "message_template": {
              "source": "{\"monitor\":\"{{ctx.monitor.name}}\",\"trigger\":\"{{ctx.trigger.name}}\",\"severity\":\"{{ctx.trigger.severity}}\",\"period_end\":\"{{ctx.periodEnd}}\"}",
              "lang": "mustache"
            },
            "throttle_enabled": true,
            "throttle": {
              "value": 30,
              "unit": "MINUTES"
            },
            "action_execution_policy": {
              "action_execution_scope": {
                "per_alert": {
                  "actionable_alerts": [
                    "DEDUPED",
                    "NEW"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
