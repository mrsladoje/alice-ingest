{
  "type": "monitor",
  "name": "trend-info-entry-lag",
  "description": "Warn when generic-log-info per-host p95 enter_system_lag_ms rises. Metric is the per-bucket p95 of enter_system_lag_ms, not the mean: backlogs show in the tail first. The baseline averages ~1000 per-bucket p95 values, so a slice p95 is compared against a typical bucket's p95 - like against like. Needs >=100 records in every slice, because a p95 over a handful of records is just the maximum. Floor 250 ms absolute as well as 2x baseline (both substituted at bootstrap). Reads the trend-rollup 10m rollup, not raw logs: the 7d baseline is a few thousand tiny docs per entity. Dwell: fire only if the breach holds on 3 consecutive 10m rollup buckets (~30m), offset 10m so the newest bucket is always complete. Baseline 7d excluding the last 40m; 24h fallback when 7d is empty. Schedule 10m. Throttle 30m per alert key via alice-incluster-alert-sink. Self-gating instead of flag-gated: a slice above the ceiling (trend_entry_lag_ceiling_ms, 1h) is archive age, not pipeline health, so under preserved June replay - where entry lag is about a month - this monitor is naturally silent, and in production - where entry lag is seconds - it is naturally live. Nothing to switch on at cutover.",
  "monitor_type": "bucket_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 10,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "trend-rollup"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "term": {
                    "family": "info"
                  }
                },
                {
                  "term": {
                    "entity_kind": "host"
                  }
                },
                {
                  "range": {
                    "ts": {
                      "gte": "{{period_end}}||-7d",
                      "lte": "{{period_end}}",
                      "format": "epoch_millis"
                    }
                  }
                }
              ]
            }
          },
          "aggregations": {
            "composite_agg": {
              "composite": {
                "size": 2000,
                "sources": [
                  {
                    "entity": {
                      "terms": {
                        "field": "entity"
                      }
                    }
                  }
                ]
              },
              "aggregations": {
                "slice0": {
                  "filter": {
                    "range": {
                      "ts": {
                        "gte": "{{period_end}}||-20m",
                        "lt": "{{period_end}}||-10m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "lag": {
                      "avg": {
                        "field": "p95_entry_lag_ms"
                      }
                    },
                    "docs": {
                      "sum": {
                        "field": "doc_count"
                      }
                    }
                  }
                },
                "slice1": {
                  "filter": {
                    "range": {
                      "ts": {
                        "gte": "{{period_end}}||-30m",
                        "lt": "{{period_end}}||-20m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "lag": {
                      "avg": {
                        "field": "p95_entry_lag_ms"
                      }
                    },
                    "docs": {
                      "sum": {
                        "field": "doc_count"
                      }
                    }
                  }
                },
                "slice2": {
                  "filter": {
                    "range": {
                      "ts": {
                        "gte": "{{period_end}}||-40m",
                        "lt": "{{period_end}}||-30m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "lag": {
                      "avg": {
                        "field": "p95_entry_lag_ms"
                      }
                    },
                    "docs": {
                      "sum": {
                        "field": "doc_count"
                      }
                    }
                  }
                },
                "baseline_7d": {
                  "filter": {
                    "range": {
                      "ts": {
                        "gte": "{{period_end}}||-7d",
                        "lt": "{{period_end}}||-40m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "lag": {
                      "avg": {
                        "field": "p95_entry_lag_ms"
                      }
                    },
                    "docs": {
                      "sum": {
                        "field": "doc_count"
                      }
                    }
                  }
                },
                "baseline_24h": {
                  "filter": {
                    "range": {
                      "ts": {
                        "gte": "{{period_end}}||-24h",
                        "lt": "{{period_end}}||-40m",
                        "format": "epoch_millis"
                      }
                    }
                  },
                  "aggregations": {
                    "lag": {
                      "avg": {
                        "field": "p95_entry_lag_ms"
                      }
                    },
                    "docs": {
                      "sum": {
                        "field": "doc_count"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "bucket_level_trigger": {
        "name": "trend-info-entry-lag",
        "severity": "2",
        "condition": {
          "buckets_path": {
            "s0_lag": "slice0>lag",
            "s1_lag": "slice1>lag",
            "s2_lag": "slice2>lag",
            "s0_docs": "slice0>docs",
            "s1_docs": "slice1>docs",
            "s2_docs": "slice2>docs",
            "b7_lag": "baseline_7d>lag",
            "b24_lag": "baseline_24h>lag"
          },
          "parent_bucket_path": "composite_agg",
          "script": {
            "source": "if (params.s0_lag == null || params.s1_lag == null || params.s2_lag == null) { return false; } double minLagDocs = 100.0; if (params.s0_docs < minLagDocs || params.s1_docs < minLagDocs || params.s2_docs < minLagDocs) { return false; } double lagFloor = 250.0; if (params.s0_lag < lagFloor || params.s1_lag < lagFloor || params.s2_lag < lagFloor) { return false; } double lagCeiling = 3600000.0; if (params.s0_lag > lagCeiling || params.s1_lag > lagCeiling || params.s2_lag > lagCeiling) { return false; } double base = (params.b7_lag != null && params.b7_lag > 0) ? params.b7_lag : ((params.b24_lag != null) ? params.b24_lag : 0); if (base <= 0) { return false; } return (params.s0_lag / base) >= 2.0 && (params.s1_lag / base) >= 2.0 && (params.s2_lag / base) >= 2.0;",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "notify",
            "destination_id": "alice-incluster-alert-sink",
            "subject_template": {
              "source": "{{ctx.monitor.name}}",
              "lang": "mustache"
            },
            "message_template": {
              "source": "{\"monitor\":\"{{ctx.monitor.name}}\",\"trigger\":\"{{ctx.trigger.name}}\",\"severity\":\"{{ctx.trigger.severity}}\",\"period_end\":\"{{ctx.periodEnd}}\"}",
              "lang": "mustache"
            },
            "throttle_enabled": true,
            "throttle": {
              "value": 30,
              "unit": "MINUTES"
            },
            "action_execution_policy": {
              "action_execution_scope": {
                "per_alert": {
                  "actionable_alerts": [
                    "DEDUPED",
                    "NEW"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
