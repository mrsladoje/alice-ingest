{
  "type": "monitor",
  "name": "trend-info-volume",
  "description": "Warn when generic-log-info per-host doc rate spikes or collapses. Run-start spikes may false-warn until gated. Dwell: fire only if breach sustained across 3 consecutive 10m slices (~30m). Ratio 2x rising (volume also <=0.5x collapse - all three slices same direction). Baseline: 7d excluding last 30m; 24h fallback when 7d empty. Schedule 30m (dwell covers the full 30m, so coverage stays continuous). Throttle 30m per alert key via alice-incluster-alert-sink. Collapse (<=0.5x) additionally requires a non-empty 24h baseline so hosts retired mid-window do not alert forever.",
  "monitor_type": "bucket_level_monitor",
  "enabled": true,
  "schedule": {
    "period": {
      "interval": 30,
      "unit": "MINUTES"
    }
  },
  "inputs": [
    {
      "search": {
        "indices": [
          "generic-log-info-*"
        ],
        "query": {
          "size": 0,
          "query": {
            "bool": {
              "filter": [
                {
                  "range": {
                    "collector_time": {
                      "gte": "{{period_end}}||-7d",
                      "lte": "{{period_end}}",
                      "format": "epoch_millis"
                    }
                  }
                }
              ]
            }
          },
          "aggregations": {
            "composite_agg": {
              "composite": {
                "size": 1000,
                "sources": [
                  {
                    "host": {
                      "terms": {
                        "field": "host"
                      }
                    }
                  }
                ]
              },
              "aggregations": {
                "slice0": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-10m",
                        "lte": "{{period_end}}",
                        "format": "epoch_millis"
                      }
                    }
                  }
                },
                "slice1": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-20m",
                        "lt": "{{period_end}}||-10m",
                        "format": "epoch_millis"
                      }
                    }
                  }
                },
                "slice2": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-30m",
                        "lt": "{{period_end}}||-20m",
                        "format": "epoch_millis"
                      }
                    }
                  }
                },
                "baseline_7d": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-7d",
                        "lt": "{{period_end}}||-30m",
                        "format": "epoch_millis"
                      }
                    }
                  }
                },
                "baseline_24h": {
                  "filter": {
                    "range": {
                      "collector_time": {
                        "gte": "{{period_end}}||-24h",
                        "lt": "{{period_end}}||-30m",
                        "format": "epoch_millis"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "triggers": [
    {
      "bucket_level_trigger": {
        "name": "trend-info-volume",
        "severity": "2",
        "condition": {
          "buckets_path": {
            "slice0": "slice0._count",
            "slice1": "slice1._count",
            "slice2": "slice2._count",
            "baseline_7d": "baseline_7d._count",
            "baseline_24h": "baseline_24h._count"
          },
          "parent_bucket_path": "composite_agg",
          "script": {
            "source": "double sliceMin = 10.0; double base = params.baseline_7d; double baseMin = 10050.0; if (base <= 0) { base = params.baseline_24h; baseMin = 1410.0; } if (base <= 0) { return false; } double baseRate = base / baseMin; double r0 = (params.slice0 / sliceMin) / baseRate; double r1 = (params.slice1 / sliceMin) / baseRate; double r2 = (params.slice2 / sliceMin) / baseRate; boolean hi = r0 >= 2.0 && r1 >= 2.0 && r2 >= 2.0; boolean lo = params.baseline_24h > 0 && r0 <= 0.5 && r1 <= 0.5 && r2 <= 0.5; return hi || lo;",
            "lang": "painless"
          }
        },
        "actions": [
          {
            "name": "notify",
            "destination_id": "alice-incluster-alert-sink",
            "subject_template": {
              "source": "{{ctx.monitor.name}}",
              "lang": "mustache"
            },
            "message_template": {
              "source": "{\"monitor\":\"{{ctx.monitor.name}}\",\"trigger\":\"{{ctx.trigger.name}}\",\"severity\":\"{{ctx.trigger.severity}}\",\"period_end\":\"{{ctx.periodEnd}}\"}",
              "lang": "mustache"
            },
            "throttle_enabled": true,
            "throttle": {
              "value": 30,
              "unit": "MINUTES"
            },
            "action_execution_policy": {
              "action_execution_scope": {
                "per_alert": {
                  "actionable_alerts": [
                    "DEDUPED",
                    "NEW"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  ]
}
