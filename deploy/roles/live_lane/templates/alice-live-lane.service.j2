# {{ ansible_managed }}
[Unit]
Description=ALICE live log lane — pushes infologger and application-logs-central to viewers without touching OpenSearch
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
MemoryAccounting=yes
MemoryHigh={{ live_lane_memory_high }}
MemoryMax={{ live_lane_memory_max }}
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=LIVE_BIND={{ live_lane_bind }}
Environment=LIVE_PORT={{ live_lane_port }}
Environment=LIVE_INGEST_PATH={{ live_lane_ingest_path }}
Environment=LIVE_STATIC_DIR={{ live_lane_static_dir }}
Environment=LIVE_REPLAY_ROWS={{ live_lane_replay_rows }}
Environment=LIVE_BUFFER_ROWS={{ live_lane_buffer_rows }}
Environment=LIVE_CLIENT_QUEUE_MAX={{ live_lane_client_queue_max }}
{% if live_lane_token | length > 0 %}
Environment=LIVE_TOKEN={{ live_lane_token }}
{% endif %}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ live_lane_script }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
