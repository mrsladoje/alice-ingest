# {{ ansible_managed }}
[Service]
# No leading dash on purpose: a missing file must fail the unit, because Fluent
# Bit expands an unset variable to an empty string without saying anything.
EnvironmentFile={{ collector_env_file }}

# The retention policy name register_node.sh attaches. The loggy_opensearch role
# owns this file, and installs the script and its index template beside it; no
# dash here either, for the same reason as above.
EnvironmentFile={{ collector_opensearch_env_file }}

# The node registers and repairs its own index before the collector starts.
# ExecStartPre counts against TimeoutStartSec, so change the two together.
ExecStartPre={{ collector_register_script }}
TimeoutStartSec={{ collector_start_timeout_seconds }}

ExecStart=
ExecStart={{ collector_binary_path }} -c {{ collector_config_dir }}/collector.yaml

{% if fluent_bit_cpuset %}
AllowedCPUs={{ fluent_bit_cpuset }}
{% endif %}
MemoryHigh={{ fluent_bit_memory_high }}
MemoryMax={{ fluent_bit_memory_max }}
