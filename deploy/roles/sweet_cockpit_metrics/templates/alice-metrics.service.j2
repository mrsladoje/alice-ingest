# {{ ansible_managed }}
[Unit]
Description=ALICE Cockpit metrics poller — control node
After=network-online.target opensearch.service opensearch-dashboards.service
Wants=network-online.target

[Service]
Type=simple
MemoryAccounting=yes
MemoryHigh={{ alice_service_memory_high }}
MemoryMax={{ alice_service_memory_max }}
DynamicUser=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Environment=OS_URL=http://localhost:{{ opensearch_http_port }}
Environment=OSD_URL=http://127.0.0.1:{{ dashboards_internal_port }}
Environment=METRICS_INDEX={{ cockpit_metrics_index }}
Environment=ROSTER_INDEX={{ fleet_roster_index }}
Environment=INTERVAL={{ cockpit_metrics_interval_seconds }}
Environment=RETENTION_DAYS={{ cockpit_metrics_retention_days }}
Environment=HEARTBEAT_GRACE_SECONDS={{ heartbeat_grace_seconds }}
Environment=EMIT_LEGACY_NODE={{ health_metrics_emit_legacy_node | bool | ternary('true', 'false') }}
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 {{ cockpit_metrics_script }}
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
