# Managed by Ansible (deploy/roles/producer) — local edits will be overwritten.
# Ceph RGW (s3.cern.ch) credentials for images/replay/replay.py's boto3
# client (AWS_PROFILE={{ s3_aws_profile }} / AWS_SHARED_CREDENTIALS_FILE, set
# by the alice-replay.service unit). Values come ONLY from ansible-vault
# (group_vars/vault.yml) — see group_vars/all.yml's s3_access_key_id /
# s3_secret_access_key indirection. Never edit this file by hand; it is
# regenerated from the vault on every run.
[{{ s3_aws_profile }}]
aws_access_key_id = {{ s3_access_key_id }}
aws_secret_access_key = {{ s3_secret_access_key }}
