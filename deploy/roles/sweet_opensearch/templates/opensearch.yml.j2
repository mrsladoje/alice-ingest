# {{ ansible_managed }}

cluster.name: {{ opensearch_cluster_name }}
node.name: {{ opensearch_instance.id }}

{% if node_tier == 'storage' %}
node.roles: [cluster_manager, data, ingest]
node.attr.role: storage
{% else %}
node.roles: [data, ingest]
node.attr.role: worker
node.attr.box: {{ node_id }}

# min() because this is a cap, never a floor.
node.processors: {{ [opensearch_worker_processors | int, ansible_processor_vcpus | int] | min }}
indices.memory.index_buffer_size: {{ opensearch_worker_index_buffer_size }}
{% endif %}

path.data: {{ opensearch_path_data_setting }}
path.logs: {{ opensearch_path_logs_setting }}

network.host:
{% for h in opensearch_network_host %}
  - {{ h }}
{% endfor %}
  - {{ opensearch_publish_host }}
network.publish_host: {{ opensearch_publish_host }}

http.port: {{ opensearch_instance.http_port }}
transport.port: {{ opensearch_instance.transport_port }}

discovery.seed_hosts:
{% for h in opensearch_seed_hosts %}
  - {{ h }}
{% endfor %}

cluster.initial_cluster_manager_nodes:
{% for n in opensearch_initial_cluster_manager_nodes %}
  - {{ n }}
{% endfor %}

# Keep. Locked memory never swaps, so this node cannot push physics pages out.
bootstrap.memory_lock: true

plugins.security.disabled: {{ opensearch_security_disabled | bool | ternary('true', 'false') }}
