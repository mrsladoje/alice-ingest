{
  "index_patterns": ["{{ cockpit_metrics_index }}"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 2,
      "codec": "zstd",
      "index.routing.allocation.require.role": "storage"
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp":            { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "kind":                  { "type": "keyword" },
        "node":                  { "type": "keyword" },
        "collector_id":          { "type": "keyword" },
        "os_node":               { "type": "keyword" },
        "heartbeat_missing":     { "type": "short" },
        "heartbeat_age_ms":      { "type": "long" },
        "roster_size":           { "type": "integer" },
        "roster_missing":        { "type": "integer" },
        "topology_version":      { "type": "keyword" },
        "am_up":                 { "type": "short" },
        "am_latency_ms":         { "type": "long" },
        "signals_open":          { "type": "integer" },
        "incidents_open":        { "type": "integer" },
        "incident_groups":       { "type": "integer" },
        "incident_group_max":    { "type": "integer" },
        "projector_cycle_ok":    { "type": "short" },
        "projector_cycle_ms":    { "type": "long" },
        "stale_episodes":        { "type": "integer" },
        "stale_dwell_p50_ms":    { "type": "long" },
        "stale_dwell_p95_ms":    { "type": "long" },
        "alertname":             { "type": "keyword" },
        "synthetic":             { "type": "boolean" },
        "poison_run_id":         { "type": "keyword" },
        "poison_stage":          { "type": "keyword" },
        "poison_targets":        { "type": "keyword" },
        "index_name":            { "type": "keyword" },
        "cluster_status":        { "type": "keyword" },
        "cluster_status_code":   { "type": "short" },
        "nodes_count":           { "type": "short" },
        "active_shards":         { "type": "integer" },
        "relocating_shards":     { "type": "integer" },
        "initializing_shards":   { "type": "integer" },
        "unassigned_shards":     { "type": "integer" },
        "pending_tasks":         { "type": "integer" },
        "index_health":          { "type": "keyword" },
        "pri":                   { "type": "short" },
        "rep":                   { "type": "short" },
        "docs_count":            { "type": "long" },
        "docs_delta":            { "type": "long" },
        "store_bytes":           { "type": "long" },
        "heap_percent":          { "type": "short" },
        "cpu_percent":           { "type": "short" },
        "disk_used_percent":     { "type": "float" },
        "indexing_total":        { "type": "long" },
        "indexing_delta":        { "type": "long" },
        "admission_rejections_total": { "type": "long" },
        "admission_rejections_delta": { "type": "long" },
        "fb_up":                 { "type": "short" },
        "fb_healthy":            { "type": "short" },
        "input_records":         { "type": "long" },
        "input_records_delta":   { "type": "long" },
        "output_records":        { "type": "long" },
        "output_records_delta":  { "type": "long" },
        "output_errors":         { "type": "long" },
        "output_errors_delta":   { "type": "long" },
        "output_retries":        { "type": "long" },
        "output_retries_delta":  { "type": "long" },
        "output_retries_failed": { "type": "long" },
        "output_retries_failed_delta": { "type": "long" },
        "output_dropped":        { "type": "long" },
        "output_dropped_delta":  { "type": "long" },
        "osd_state":             { "type": "keyword" },
        "osd_state_code":        { "type": "short" },
        "rss_bytes":             { "type": "long" },
        "event_loop_delay":      { "type": "float" },
        "load_1m":               { "type": "float" },
        "response_avg_ms":       { "type": "float" },
        "response_max_ms":       { "type": "float" },
        "requests_total":        { "type": "integer" },
        "concurrent_connections": { "type": "integer" },
        "stamper_up":            { "type": "short" },
        "stamper_records":       { "type": "long" },
        "stamper_records_delta": { "type": "long" },
        "stamper_chunks":        { "type": "long" },
        "stamper_chunks_delta":  { "type": "long" },
        "stamper_duplicate_chunks": { "type": "long" },
        "stamper_duplicate_chunks_delta": { "type": "long" },
        "stamper_return_failures": { "type": "long" },
        "stamper_return_failures_delta": { "type": "long" },
        "stamper_no_template_records": { "type": "long" },
        "stamper_oversize_records": { "type": "long" },
        "stamper_late_records":  { "type": "long" },
        "stamper_journal_bytes": { "type": "long" },
        "stamper_journal_lines": { "type": "long" },
        "stamper_clusters":      { "type": "integer" },
        "stamper_ledger_buckets": { "type": "integer" },
        "stamper_ledger_versions": { "type": "integer" },
        "stamper_publications":  { "type": "long" },
        "stamper_publication_failures": { "type": "long" },
        "stamper_publication_failures_delta": { "type": "long" },
        "stamper_peak_rss_bytes": { "type": "long" },
        "stamper_socket_backlog": { "type": "integer" },
        "stamper_published_through": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "stamper_last_publish":  { "type": "date", "format": "strict_date_optional_time||epoch_millis" }
      }
    }
  },
  "_meta": { "note": "cockpit health metrics from the alice-metrics poller; durable, storage tier" }
}
