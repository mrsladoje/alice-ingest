{
  "index_patterns": ["{{ signals_index }}"],
  "priority": 200,
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 2,
      "codec": "zstd",
      "refresh_interval": "5s",
      "index.routing.allocation.require.role": "storage"
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp":         { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "source_id":          { "type": "keyword" },
        "source_kind":        { "type": "keyword" },
        "source_index":       { "type": "keyword" },
        "source_uid":         { "type": "keyword" },
        "alertname":          { "type": "keyword" },
        "state":              { "type": "keyword" },
        "severity":           { "type": "keyword" },
        "cluster_id":         { "type": "keyword" },
        "entity_kind":        { "type": "keyword" },
        "entity_id":          { "type": "keyword" },
        "collector_id":       { "type": "keyword" },
        "family":             { "type": "keyword" },
        "notification_scope": { "type": "keyword" },
        "feed":               { "type": "keyword" },
        "run":                { "type": "keyword" },
        "topology_version":   { "type": "keyword" },
        "incident_id":        { "type": "keyword" },
        "episode_id":         { "type": "keyword" },
        "group_id":           { "type": "keyword" },
        "class":              { "type": "keyword" },
        "suppressed_by":      { "type": "keyword" },
        "first_seen":         { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "last_seen":          { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "start_time":         { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "end_time":           { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "monitor_id":         { "type": "keyword" },
        "detector_id":        { "type": "keyword" },
        "grade":              { "type": "double" },
        "confidence":         { "type": "double" },
        "episode_state":      { "type": "keyword" },
        "healthy_windows":    { "type": "integer" },
        "evidence":           { "properties": {
          "bucket_keys":    { "type": "keyword" },
          "member_count":   { "type": "integer" },
          "entity_samples": { "type": "keyword" },
          "period_end":     { "type": "keyword" },
          "note":           { "type": "keyword" }
        } }
      }
    }
  },
  "_meta": { "family": "signals", "written_by": "alice-signal-projector", "note": "one lossless row per source signal; the drill-down target behind alice-incidents" }
}
