{
  "version": 1,
  "default_window_seconds": 120,
  "causes": {
    "collector-down": {
      "promotion_order": 1,
      "rationale": "Scoped to one collector, so a wrong suppression hides one machine. Needs the roster populated first, or it falls closed to the none sentinel and does nothing."
    },
    "telemetry-silence": {
      "promotion_order": 2,
      "rationale": "Cluster-scoped, but its targets are all control-plane monitors, disjoint from the collector set. When the poller is dead those monitors have no fresh input, so their firing carries no information."
    },
    "fleet-fb-silence": {
      "promotion_order": 3,
      "rationale": "Last, and the dangerous one. It mutes collector-down itself across the whole fleet. A staged restart that trips the 50 percent threshold would hide every real per-collector failure at once."
    }
  },
