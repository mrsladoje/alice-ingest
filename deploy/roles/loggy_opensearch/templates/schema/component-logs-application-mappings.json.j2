{
  "template": {
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp":  { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "ingest_time": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "collector_time": { "type": "date", "format": "strict_date_optional_time||epoch_millis" },
        "ingest_lag_ms": { "type": "long" },
        "enter_system_lag_ms": { "type": "long" },
        "log_source": { "type": "keyword" },
        "node":       { "type": "keyword" },
        "severity":   { "type": "keyword" },
        "severity_norm": { "type": "keyword" },
        "origin_host":   { "type": "keyword" },
        "synthetic":     { "type": "boolean" },
        "poison_run_id": { "type": "keyword" },
        "poison_stage":  { "type": "keyword" },
        "poison_targets": { "type": "keyword" },
        "host":       { "type": "keyword" },
        "source_file": { "type": "keyword" },
        "tid":        { "type": "keyword" },
        "facility":   { "type": "keyword" },
        "program":    { "type": "keyword" },
        "log_time":   { "type": "keyword" },
        "clients":       { "type": "integer" },
        "client_limit":  { "type": "integer" },
        "slot_id":       { "type": "keyword" },
        "channel_id":    { "type": "keyword" },
        "channel":       { "type": "keyword" },
        "task":          { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 1024 } } },
        "bc":            { "type": "integer" },
        "orbit":         { "type": "long" },
        "feeid":         { "type": "keyword" },
        "chip":          { "type": "integer" },
        "decoder_error": { "type": "keyword" },
        "comm":       { "type": "keyword" },
        "pid":           { "type": "integer" },
        "partition":     { "type": "keyword" },
        "run":           { "type": "long" },
        "PRIORITY":   { "type": "keyword" },
        "TRANSPORT":  { "type": "keyword" },
        "SYSTEMD_UNIT": { "type": "keyword" },
        "HOSTNAME":   { "type": "keyword" },
        "PID":        { "type": "integer" },
        "COMM":       { "type": "keyword" },
        "doc_id":     { "type": "keyword" },
        "template_version": { "type": "keyword" },
        "template_id":      { "type": "keyword" },
        "template_status":  { "type": "keyword" },
        "message":    { "type": "text", "fields": { "keyword": { "type": "keyword", "ignore_above": 1024 } } }
      }
    }
  },
  "_meta": {
    "family": "application-logs",
    "sources": ["dds", "stdout", "ildaemon", "journald", "odc"],
    "note": "Numbers are typed so they can be charted and alerted on; stored as text they can only be read. slot_id, channel_id, channel and task come from DDS and say what was supposed to be running; the two identifiers are unsigned 64-bit values that overflow even a signed long, so they are keywords and are never charted. bc, orbit, feeid, chip and decoder_error are the per-component fault signal; program is the process that wrote the line, on every source that has one. log_time is O2's own clock, kept as a keyword because it carries no date and must never be read as one. clients/client_limit are the InfoLogger daemon's connection count against its ceiling. comm is the process named inside a kernel trace, and it is the join key from a fault back to the O2 logs. partition and run come from the run orchestrator and carry the same two values InfoLogger does, so an orchestration failure and the detector messages from the same run join on them; pid is the orchestrator's own process. doc_id is the identifier the collector writes each record under, so a bulk request that was applied but whose success response was lost is retried as an overwrite instead of a second document; it is mapped because the output leaves it in the body, and it is the only field here that is also the document _id. template_version, template_id and template_status are written by alice-stamper before the record reaches OpenSearch: the exact template version the record matched, its mask-class-collapsed identifier, and whether it matched, created the cluster, was refused at the state limit or produced no template."
  }
}
